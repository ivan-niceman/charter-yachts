---
import { Image } from 'astro:assets';

const slidesText = [
  {
    title: 'Премиальные яхтенные путешествия по всему миру.',
    text: 'Свобода открывать новые горизонты в собственном ритме.',
  },
  {
    title: 'Индивидуальные морские путешествия.',
    text: 'Уединённые бухты, острова и впечатления, доступные только с борта яхты.',
  },
  {
    title: 'Семейный отдых и мероприятия на яхте.',
    text: 'Пространство для общения, отдыха и незабываемых моментов вместе.',
  },
  {
    title: 'Тимбилдинги и корпоративные путешествия нового формата.',
    text: 'Объединяйте команды там, где нет границ, расписаний и городской суеты.',
  },
];

const heroImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/hero/hero-*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const sortedImages = Object.entries(heroImages)
  .sort(([pathA], [pathB]) => pathA.localeCompare(pathB, undefined, { numeric: true }))
  .map(([, mod]) => mod.default);

const slides = slidesText
  .map((text, index) => ({ ...text, image: sortedImages[index] }))
  .filter((slide) => Boolean(slide.image));

const features = [
  { icon: 'users', text: 'Индивидуальный подход и маршруты' },
  { icon: 'boats', text: 'Премиальный флот яхт и катамаранов' },
  { icon: 'star', text: 'Полный сервис 5★ уровня' },
  { icon: 'shield', text: 'Безопасность и конфиденциальность' },
  { icon: 'support', text: '24/7 поддержка на всех этапах' },
];
---

<section class="hero">
  <div class="hero__bg-slider">
    {slides.map((slide, index) => (
      <div class="hero__bg-slide" class:list={{ 'is-active': index === 0 }} data-hero-bg-slide>
        <Image
          src={slide.image}
          alt={slide.title}
          width={1920}
          height={1080}
          loading={index === 0 ? 'eager' : 'lazy'}
          format="webp"
          class="hero__bg-img"
        />
      </div>
    ))}
    <div class="hero__bg-overlay"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <span class="hero__label">Премиальный отдых на яхтах</span>

      <div class="hero__text-stack">
        {slides.map((slide, index) => (
          <div class="hero__text-slide" class:list={{ 'is-active': index === 0 }} data-hero-text-slide>
            <h1 class="hero__title">{slide.title}</h1>
            <p class="hero__description">{slide.text}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
  <div class="container hero__actions">
    <a href="#booking" class="hero__btn hero__btn--primary">Подобрать яхту</a>
    <a href="tel:+78005559922" class="hero__btn hero__btn--secondary">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-astro-cid-ge2uvauf=""><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" data-astro-cid-ge2uvauf=""></path></svg>
      <span>Связаться с экспертом</span></a>
  </div>

  <ul class="hero__features container">
    {features.map((feature) => (
      <li class="hero__feature">
        <span class="hero__feature-icon">
          {feature.icon === 'users' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          )}
          {feature.icon === 'boats' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 21c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1 .6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M19.38 20A11.6 11.6 0 0 0 21 14l-9-4-9 4c0 2.9.94 5.34 2.81 7.76"/><path d="M19 13V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6"/><path d="M12 10V2"/></svg>
          )}
          {feature.icon === 'star' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          )}
          {feature.icon === 'shield' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          )}
          {feature.icon === 'support' && (
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          )}
        </span>
        <span class="hero__feature-text">{feature.text}</span>
      </li>
    ))}
  </ul>
<div class="hero__wave-divider" aria-hidden="true">
  <svg viewBox="0 0 1440 140" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M0,60 C360,105 720,95 1000,50 C1220,20 1360,5 1440,0 L1440,140 L0,140 Z"
      fill="rgba(224, 244, 242, 0.65)"
    ></path>
    <path
      d="M0,80 C380,120 760,108 1060,60 C1260,28 1380,10 1440,0 L1440,140 L0,140 Z"
      fill="#f6faf9"
    ></path>
  </svg>
</div>
</section>

<script>
  let currentIndex = 0;
  const textSlides = document.querySelectorAll('[data-hero-text-slide]');
  const bgSlides = document.querySelectorAll('[data-hero-bg-slide]');
  const totalSlides = Math.min(textSlides.length, bgSlides.length);

  if (totalSlides > 1) {
    setInterval(() => {
      textSlides[currentIndex]?.classList.remove('is-active');
      bgSlides[currentIndex]?.classList.remove('is-active');

      currentIndex = (currentIndex + 1) % totalSlides;

      textSlides[currentIndex]?.classList.add('is-active');
      bgSlides[currentIndex]?.classList.add('is-active');
    }, 10000);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: 60px;
    padding-bottom: 90px;
    /* overflow: hidden; */
  }

  /* Full Background Slider */
  .hero__bg-slider {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .hero__bg-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.2s ease-in-out, visibility 1.2s;
  }

  .hero__bg-slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .hero__bg-slider :global(.hero__bg-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.1);
    transition: transform 0s 1.2s;
  }

    .hero__bg-slide.is-active :global(.hero__bg-img) {
    animation: kenburns 10s ease-out forwards;
  }

  @keyframes kenburns {
    0% {
      transform: scale(1);
    }
    100% {
      transform: scale(1.1);
    }
  }

  .hero__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      #eef7f6 0%,
      rgba(238, 247, 246, 0.95) 20%,
      rgba(238, 247, 246, 0.65) 35%,
      rgba(238, 247, 246, 0.25) 50%
    );
    z-index: 2;
  }

  .hero__inner {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    /* min-height: 440px; */
  }

  .hero__content {
    max-width: 620px;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__label {
    display: inline-block;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 2px;
    color: var(--color-orange);
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .hero__text-stack {
    position: relative;
    min-height: 190px;
    margin-bottom: 28px;
  }

  .hero__text-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity 0.8s ease, transform 0.8s ease, visibility 0.8s;
  }

  .hero__text-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .hero__title {
    font-size: clamp(2.2rem, 3.6vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text-main);
    letter-spacing: -0.8px;
    margin-bottom: 16px;
  }

  .hero__description {
    font-size: clamp(1.05rem, 1.25vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-text-main);
    font-weight: 500;
    max-width: 580px;
  }

  .hero__actions {
    display: flex;
    align-items: flex-end;
    flex: 1;
    gap: 18px;
    flex-wrap: wrap;
    z-index: 3;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 15px 32px;
    font-size: 1rem;
    font-weight: 700;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .hero__btn--primary {
    background-color: var(--color-orange);
    color: #ffffff;
    box-shadow: 0 8px 22px rgba(255, 105, 0, 0.3);
  }

  .hero__btn--primary:hover {
    background-color: var(--color-orange-dark);
    box-shadow: 0 12px 28px rgba(255, 105, 0, 0.4);
  }

  .hero__btn--secondary {
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    color: #072228;
    outline: 2px solid rgba(10, 82, 70, 0.25);
  }

  .hero__btn--secondary:hover {
    background-color: #ffffff;
    outline-color: var(--color-emerald-main);
  }

  /* Features Bar */
  .hero__features {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin-top: 48px;
  }

  .hero__feature {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 5px 8px;
    background-color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(12px);
    border-radius: var(--radius-sm);
    border: 1px solid rgba(10, 82, 70, 0.3);
    box-shadow: var(--shadow-sm);
  }

  .hero__feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--color-emerald-main);
    flex-shrink: 0;
  }

  .hero__feature-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: #072228;
    line-height: 1.35;
  }

  @media (max-width: 1024px) {
    .hero__bg-overlay {
      background: linear-gradient(180deg, #eef7f6f2 10%, #eef7f6d9 20%, #eef7f63a 40%);
    }
    .hero__features {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hero__features {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .hero__actions {
      margin-top: 60px;
    }
    .hero__text-stack {
      min-height: 180px;
    }
  }

  @media (max-width: 480px) {
    .hero__features {
      grid-template-columns: 1fr;
    }
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
/* Волнистый разделитель */
.hero__wave-divider {
  position: absolute;
  bottom: -5px;
  left: 0;
  width: 100%;
  height: 100px;
  z-index: 2;
  pointer-events: none;
  overflow: hidden;
}

.hero__wave-divider svg {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
}
</style>