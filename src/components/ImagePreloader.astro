---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  class: className = '',
  loading = 'lazy'
} = Astro.props;
---

<div class={`img-preloader-wrapper ${className}`}>
  <div class="img-skeleton">
    <div class="img-spinner">
      <svg class="spinner-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10" stroke-opacity="0.25"></circle>
        <path d="M12 2 a10 10 0 0 1 10 10" stroke-linecap="round"></path>
      </svg>
    </div>
  </div>

  <img
    src={src}
    alt={alt}
    loading={loading}
    referrerpolicy="no-referrer"
    draggable="false"
    class="preloaded-img"
    onload="this.parentElement.classList.add('is-loaded')"
    onerror="this.parentElement.classList.add('is-error')"
  />
</div>

<style>
  .img-preloader-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .img-skeleton {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.4s ease-out, visibility 0.4s ease-out;
  }

  .img-spinner {
    width: 26px;
    height: 26px;
    color: var(--color-orange, #e07a5f);
    opacity: 0.7;
  }

  .spinner-icon {
    width: 100%;
    height: 100%;
    animation: spin 1s linear infinite;
  }

  .preloaded-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease-in-out, transform 0.6s ease;
    position: relative;
  }

  .img-preloader-wrapper.is-loaded .img-skeleton {
    opacity: 0;
    visibility: hidden;
  }

  .img-preloader-wrapper.is-loaded .preloaded-img {
    opacity: 1;
  }

  .img-preloader-wrapper.is-error .img-skeleton {
    animation: none;
    background: #f1f5f9;
  }

  .img-preloader-wrapper.is-error .img-spinner {
    display: none;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>