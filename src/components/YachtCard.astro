---
import type { Yacht, Country } from '../lib/sheets';
import { parseAllMedia } from '../lib/sheets';

interface Props {
  yacht: Yacht;
  country?: Country;
}

const { yacht, country } = Astro.props;

const mediaItems = parseAllMedia(yacht.images || []);
const hasVideo = mediaItems.some(m => m.isVideo);

// Find first good image or thumbnail for card cover
const firstImage = mediaItems.find(m => !m.isVideo)?.url;
const firstThumb = mediaItems.find(m => m.thumbnail)?.thumbnail;
const displayImage = firstImage || firstThumb || '';
---

<div class="yacht-card" data-yacht-id={yacht.id} data-country-id={yacht.countryId} data-country-name={yacht.countryName || country?.name || ''}>
  <div class="yacht-image-wrap">
    <img
      src={displayImage}
      data-raw-src={displayImage}
      alt={yacht.name}
      class="yacht-image"
      loading="lazy"
      referrerpolicy="no-referrer"
      draggable="false"
      onerror="if(window.repairYandexImage){window.repairYandexImage(this);}"
    />
    <div class="yacht-badges">
      {country && (
        <span class="badge country-badge">
          {country.name}
        </span>
      )}
      {hasVideo && (
        <span class="badge video-badge" title="Есть видео яхты">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          Видео
        </span>
      )}
    </div>
  </div>

  <div class="yacht-body">
    <h3 class="yacht-title">{yacht.name}</h3>

    <div class="yacht-actions">
      <button
        type="button"
        class="btn btn-secondary action-details"
        data-details-id={yacht.id}
      >
        Подробнее
      </button>
      <a
        href="#booking"
        class="btn btn-primary action-book"
        data-book-yacht={yacht.name}
      >
        Забронировать
      </a>
    </div>
  </div>
</div>

<style is:global>
  .yacht-card {
    background-color: #ffffff;
    border-radius: 16px;
    border: 1px solid rgba(10, 82, 70, 0.12);
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(5, 51, 43, 0.05);
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.3s;
    position: relative;
    height: 100%;
  }

  .yacht-card:hover {
    box-shadow: 0 16px 36px rgba(5, 51, 43, 0.12);
  }

  .yacht-image-wrap {
    position: relative;
    height: 240px;
    overflow: hidden;
    background-color: var(--color-bg-light);
  }

  .yacht-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .yacht-image-wrap:hover .yacht-image {
    transform: scale(1.06);
  }

  .yacht-badges {
    position: absolute;
    top: 14px;
    left: 14px;
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .badge {
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .country-badge {
    background: rgba(255, 255, 255, 0.95);
    color: #0a5246;
  }

  .video-badge {
    background: rgba(255, 105, 0, 0.92);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .yacht-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
    gap: 16px;
  }

  .yacht-title {
    font-size: 20px;
    font-weight: 700;
    color: #0a5246;
    margin: 0;
    line-height: 1.35;
  }

  .yacht-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: auto;
  }

  .action-details, .action-book {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 16px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .action-details {
    background-color: #f0f7f6;
    color: #0a5246;
    border: 1px solid rgba(10, 82, 70, 0.15);
  }

  .action-details:hover {
    background-color: #0a5246;
    color: #ffffff;
  }

  .action-book {
    background-color: #ff6900;
    color: #ffffff;
    border: none;
    box-shadow: 0 4px 12px rgba(255, 105, 0, 0.25);
  }

  .action-book:hover {
    background-color: #e05d00;
    box-shadow: 0 6px 16px rgba(255, 105, 0, 0.35);
  }
</style>
