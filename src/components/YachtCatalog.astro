---
import type { Yacht, Country } from '../lib/sheets';
import YachtCard from './YachtCard.astro';
import YachtModal from './YachtModal.astro';

interface Props {
  yachts: Yacht[];
  countries: Country[];
}

const { yachts, countries } = Astro.props;
---

<section id="yachts" class="section yachts-section">
  <div class="container">
    <div class="section-header">
      <h2 class="title">Яхты</h2>
      <h3 class="subtitle">Каталог яхт</h3>
    </div>

    <!-- Filter Bar: Custom Dropdown -->
    <div class="filter-bar">
      <div class="filter-group-wrapper">
        <span class="filter-label">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="label-icon">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          Выберите направление:
        </span>

        <!-- Custom Dropdown -->
        <div class="custom-dropdown" id="destinations-dropdown">
          <button
            type="button"
            class="dropdown-trigger"
            id="dropdown-trigger"
            aria-expanded="false"
          >
            <div class="trigger-left">
              <span class="trigger-title" id="trigger-title">Все направления</span>
            </div>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="trigger-arrow" id="trigger-arrow">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>

          <div class="dropdown-menu" id="dropdown-menu">
            <div class="dropdown-item item-selected" data-country-id="all">
              <div class="item-content">
                <span class="item-name">Все направления</span>
              </div>
            </div>

            <div class="dropdown-divider"></div>

            {countries.map((c: Country) => (
              <div class="dropdown-item" data-country-id={c.id}>
                <div class="item-content">
                  <span class="item-name">{c.name}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Yacht Cards Grid -->
    <div class="yachts-grid" id="yachts-grid">
      {yachts.map((yacht: Yacht) => {
        const country = countries.find((c: Country) => c.id === yacht.countryId);
        return <YachtCard yacht={yacht} country={country} />;
      })}
    </div>

    <script is:inline>
      (function() {
        try {
          var cachedTabs = localStorage.getItem('yacht_active_tabs_cache');
          if (cachedTabs) {
            var payload = JSON.parse(cachedTabs);
            if (payload && payload.activeNames && payload.activeNames.length > 0) {
              var allowed = {};
              payload.activeNames.forEach(function(n) {
                var clean = (n || '').toLowerCase().replace(/[\u{1F300}-\u{1F9FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E6}-\u{1F1FF}]+/gu, '').replace(/[^a-zа-яё0-9]/gi, '').trim();
                allowed[n.toLowerCase().trim()] = true;
                allowed[clean] = true;
              });

              var grid = document.getElementById('yachts-grid');
              if (grid) {
                var ycards = Array.from(grid.querySelectorAll('.yacht-card'));
                ycards.forEach(function(card) {
                  var cId = (card.getAttribute('data-country-id') || '').toLowerCase().trim();
                  var cName = (card.getAttribute('data-country-name') || '').toLowerCase().trim();
                  var cleanCName = (cName || '').replace(/[^a-zа-яё0-9]/gi, '').trim();
                  var cleanCId = (cId || '').replace(/[^a-zа-яё0-9]/gi, '').trim();
                  if (!allowed[cId] && !allowed[cName] && !allowed[cleanCName] && !allowed[cleanCId]) {
                    card.style.display = 'none';
                  }
                });

                if (payload.activeTabs && Array.isArray(payload.activeTabs) && payload.activeTabs.length > 0) {
                  var INLINE_FLAG_MAP = {
                    turkey: 'tr', turtsiya: 'tr', 'турция': 'tr',
                    maldives: 'mv', maldivy: 'mv', 'мальдивы': 'mv',
                    indonesia: 'id', indoneziya: 'id', 'индонезия': 'id',
                    seychelles: 'sc', seyshely: 'sc', 'сейшелы': 'sc',
                    galapagos: 'ec', ecuador: 'ec', galapagosy: 'ec', 'галапагосы': 'ec',
                    oman: 'om', 'оман': 'om', palau: 'pw', 'палау': 'pw',
                    egypt: 'eg', egipet: 'eg', 'египет': 'eg',
                    'costa-rica': 'cr', costarica: 'cr', 'коста-рика': 'cr', 'kosta-rika': 'cr',
                    russia: 'ru', rossiya: 'ru', 'россия': 'ru',
                    thailand: 'th', 'таиланд': 'th', 'тайланд': 'th',
                    greece: 'gr', gretsiya: 'gr', 'греция': 'gr',
                    italy: 'it', italiya: 'it', 'италия': 'it',
                    spain: 'es', ispaniya: 'es', 'испания': 'es',
                    croatia: 'hr', khorvatiya: 'hr', 'хорватия': 'hr',
                    norway: 'no', norvegiya: 'no', 'норвегия': 'no',
                    france: 'fr', frantsiya: 'fr', 'франция': 'fr',
                    montenegro: 'me', chernogoriya: 'me', 'черногория': 'me'
                  };
                  var getRank = function(card) {
                    var cName = (card.getAttribute('data-country-name') || '').toLowerCase().replace(/[^a-zа-яё0-9]/gi, '').trim();
                    var cId = (card.getAttribute('data-country-id') || '').toLowerCase().replace(/[^a-zа-яё0-9]/gi, '').trim();
                    var badge = (card.querySelector('.country-badge') ? card.querySelector('.country-badge').textContent : '').toLowerCase().replace(/[^a-zа-яё0-9]/gi, '').trim();
                    var cIso = INLINE_FLAG_MAP[cName] || INLINE_FLAG_MAP[cId] || INLINE_FLAG_MAP[badge] || '';
                    for (var i = 0; i < payload.activeTabs.length; i++) {
                      var tRaw = (payload.activeTabs[i].name || '');
                      var tCleanName = tRaw.replace(/[\u{1F300}-\u{1F9FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E6}-\u{1F1FF}]+/gu, '').trim();
                      var tClean = tCleanName.toLowerCase().replace(/[^a-zа-яё0-9]/gi, '').trim();
                      var tRawClean = tRaw.toLowerCase().replace(/[^a-zа-яё0-9]/gi, '').trim();
                      var tIso = INLINE_FLAG_MAP[tClean] || INLINE_FLAG_MAP[tRawClean] || '';
                      if (cName === tClean || cName === tRawClean || cId === tClean || badge === tClean || badge === tRawClean || (cIso && tIso && cIso === tIso)) return i;
                    }
                    return 9999;
                  };
                  var origIndices = new Map();
                  ycards.forEach(function(c, idx) { origIndices.set(c, idx); });
                  ycards.sort(function(a, b) {
                    var diff = getRank(a) - getRank(b);
                    if (diff !== 0) return diff;
                    return (origIndices.get(a) || 0) - (origIndices.get(b) || 0);
                  });
                  ycards.forEach(function(card) { grid.appendChild(card); });
                }
              }

              var menu = document.getElementById('dropdown-menu');
              if (menu) {
                if (payload.activeTabs && Array.isArray(payload.activeTabs) && payload.activeTabs.length > 0) {
                  var allItem = menu.querySelector('.dropdown-item[data-country-id="all"]');
                  var divider = menu.querySelector('.dropdown-divider');
                  if (allItem) menu.appendChild(allItem);
                  if (divider) menu.appendChild(divider);

                  var items = Array.from(menu.querySelectorAll('.dropdown-item:not([data-country-id="all"])'));
                  var used = {};
                  payload.activeTabs.forEach(function(tab) {
                    var rawName = tab.name || '';
                    var cleanName = rawName.replace(/[\u{1F300}-\u{1F9FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E6}-\u{1F1FF}]+/gu, '').trim();
                    var clean = cleanName.toLowerCase().replace(/[^a-zа-яё0-9]/gi, '').trim();
                    var found = items.find(function(it) {
                      if (used[it]) return false;
                      var iId = (it.getAttribute('data-country-id') || '').toLowerCase().replace(/[^a-zа-яё0-9]/gi, '').trim();
                      var iName = (it.querySelector('.item-name') ? it.querySelector('.item-name').textContent : '').toLowerCase().replace(/[^a-zа-яё0-9]/gi, '').trim();
                      return iId === clean || iName === clean;
                    });
                    if (found) {
                      found.style.display = 'flex';
                      menu.appendChild(found);
                      used[found] = true;
                    } else {
                      var newItem = document.createElement('div');
                      newItem.className = 'dropdown-item';
                      newItem.setAttribute('data-country-id', clean);
                      newItem.innerHTML = '<div class="item-content"><span class="item-name">' + cleanName + '</span></div>';
                      menu.appendChild(newItem);
                    }
                  });
                  items.forEach(function(it) {
                    if (!used[it]) {
                      it.style.display = 'none';
                      menu.appendChild(it);
                    }
                  });
                } else {
                  var items = menu.querySelectorAll('.dropdown-item');
                  items.forEach(function(item) {
                    var itemId = (item.getAttribute('data-country-id') || '').toLowerCase().trim();
                    if (itemId !== 'all') {
                      var cleanItemId = itemId.replace(/[^a-zа-яё0-9]/gi, '').trim();
                      if (!allowed[itemId] && !allowed[cleanItemId]) {
                        item.style.display = 'none';
                      }
                    }
                  });
                }
              }
            }
          }
        } catch(e) {}
      })();
    </script>

    <!-- Show More Button -->
    <div class="show-more-container" id="show-more-container" style="display: none;">
      <button type="button" class="show-more-btn" id="show-more-btn">
        <span>Показать ещё</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>

    <!-- Yacht Modals -->
    <div id="yacht-modals-container">
      {yachts.map((yacht: Yacht) => {
        const country = countries.find((c: Country) => c.id === yacht.countryId);
        return <YachtModal yacht={yacht} country={country} />;
      })}
    </div>

    <!-- Empty State -->
    <div class="empty-state" id="yachts-empty-state" style="display: none;">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-icon">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <h3>Яхты не найдены</h3>
      <p>Попробуйте выбрать другое направление из списка.</p>
      <button type="button" class="btn btn-primary" id="reset-filter-btn">
        Сбросить фильтр
      </button>
    </div>
  </div>
</section>

<script>
  import {
    parseFullCSV,
    extractFlag,
    transliterate,
    extractUrls,
    formatUniversalImageUrl,
    formatGoogleDriveImageUrl,
    resolveYandexDiskResource,
    parseAllMedia,
    DEFAULT_PUBLISHED_SHEET_KEY
  } from '../lib/sheets';

  document.addEventListener('DOMContentLoaded', () => {
    const dropdown = document.getElementById('destinations-dropdown');
    const trigger = document.getElementById('dropdown-trigger');
    const menu = document.getElementById('dropdown-menu');
    const triggerTitle = document.getElementById('trigger-title');
    const arrow = document.getElementById('trigger-arrow');

    const emptyState = document.getElementById('yachts-empty-state');
    const resetBtn = document.getElementById('reset-filter-btn');
    const grid = document.getElementById('yachts-grid');
    const modalsContainer = document.getElementById('yacht-modals-container');

    let currentCountry = 'all';
    let currentCountryDisplayName = 'Все направления';
    let isExpanded = false;
    let allowedCountries: Set<string> | null = null;
    const loadedGids = new Set<string>();

    const CLIENT_FLAGS_MAP: Record<string, string> = {
      maldives: 'mv', indonesia: 'id', seychelles: 'sc', galapagos: 'ec', ecuador: 'ec',
      oman: 'om', palau: 'pw', egypt: 'eg', 'costa-rica': 'cr', costarica: 'cr',
      russia: 'ru', thailand: 'th', turkey: 'tr', greece: 'gr', italy: 'it', spain: 'es',
      croatia: 'hr', norway: 'no', france: 'fr', montenegro: 'me',
      мальдивы: 'mv', индонезия: 'id', сейшелы: 'sc', галапагосы: 'ec',
      оман: 'om', палау: 'pw', египет: 'eg', 'коста-рика': 'cr', костарика: 'cr',
      россия: 'ru', таиланд: 'th', тайланд: 'th', турция: 'tr', греция: 'gr',
      италия: 'it', испания: 'es', хорватия: 'hr', норвегия: 'no', франция: 'fr', черногория: 'me',
      turtsiya: 'tr', maldivy: 'mv', indoneziya: 'id', seyshely: 'sc', galapagosy: 'ec'
    };

    function cleanStr(s: string): string {
      return (s || '')
        .toLowerCase()
        .replace(/[\u{1F300}-\u{1F9FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E6}-\u{1F1FF}]+/gu, '')
        .replace(/[^a-zа-яё0-9]/gi, '')
        .trim();
    }

    function getCardTabIndex(card: HTMLElement, activeTabs: { name: string; gid: string }[]): number {
      const cName = cleanStr(card.getAttribute('data-country-name') || '');
      const cId = cleanStr(card.getAttribute('data-country-id') || '');
      const badge = cleanStr(card.querySelector('.country-badge')?.textContent || '');
      const cNameTrans = cleanStr(transliterate(cName));
      const badgeTrans = cleanStr(transliterate(badge));
      const cIso = CLIENT_FLAGS_MAP[cName] || CLIENT_FLAGS_MAP[cId] || CLIENT_FLAGS_MAP[badge] || CLIENT_FLAGS_MAP[cNameTrans] || '';

      for (let i = 0; i < activeTabs.length; i++) {
        const { cleanName } = extractFlag(activeTabs[i].name);
        const tabClean = cleanStr(cleanName);
        const tabSlug = cleanStr(transliterate(cleanName));
        const rawClean = cleanStr(activeTabs[i].name);
        const tabIso = CLIENT_FLAGS_MAP[tabClean] || CLIENT_FLAGS_MAP[tabSlug] || '';

        if (
          cName === tabClean ||
          cName === rawClean ||
          cId === tabClean ||
          cId === tabSlug ||
          badge === tabClean ||
          badge === rawClean ||
          (cNameTrans && (cNameTrans === tabSlug || cNameTrans === tabClean)) ||
          (badgeTrans && (badgeTrans === tabSlug || badgeTrans === tabClean)) ||
          (cIso && tabIso && cIso === tabIso)
        ) {
          return i;
        }
      }
      return 9999;
    }

    function reorderGridCards(activeTabs: { name: string; gid: string }[]) {
      if (!grid || !activeTabs || !Array.isArray(activeTabs) || activeTabs.length === 0) return;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.yacht-card'));
      if (cards.length === 0) return;

      const initialIndices = new Map<HTMLElement, number>();
      cards.forEach((card, idx) => initialIndices.set(card, idx));

      cards.sort((a, b) => {
        const rankA = getCardTabIndex(a, activeTabs);
        const rankB = getCardTabIndex(b, activeTabs);
        if (rankA !== rankB) return rankA - rankB;
        return (initialIndices.get(a) || 0) - (initialIndices.get(b) || 0);
      });

      cards.forEach(card => grid.appendChild(card));
      updateYachtVisibility();
    }

    function reorderDropdownItems(activeTabs: { name: string; gid: string }[]) {
      if (!menu || !activeTabs || !Array.isArray(activeTabs) || activeTabs.length === 0) return;

      const allItem = menu.querySelector<HTMLElement>('.dropdown-item[data-country-id="all"]');
      const divider = menu.querySelector<HTMLElement>('.dropdown-divider');

      const existingItems = Array.from(menu.querySelectorAll<HTMLElement>('.dropdown-item:not([data-country-id="all"])'));
      const usedElements = new Set<HTMLElement>();

      menu.innerHTML = '';
      if (allItem) menu.appendChild(allItem);
      if (divider) menu.appendChild(divider);

      activeTabs.forEach((tab) => {
        const { cleanName } = extractFlag(tab.name);
        const tabClean = cleanStr(cleanName);
        const tabSlug = transliterate(cleanName) || tabClean;
        const tabLower = cleanName.toLowerCase().trim();
        const tabIso = CLIENT_FLAGS_MAP[tabClean] || CLIENT_FLAGS_MAP[tabSlug] || '';

        let matched = existingItems.find(item => {
          if (usedElements.has(item)) return false;
          const itemId = (item.getAttribute('data-country-id') || '').toLowerCase().trim();
          const itemName = (item.querySelector('.item-name')?.textContent || '').toLowerCase().trim();
          const itemClean = cleanStr(itemName);
          const itemIdClean = cleanStr(itemId);
          const itemIso = CLIENT_FLAGS_MAP[itemClean] || CLIENT_FLAGS_MAP[itemIdClean] || '';
          return (
            cleanStr(itemId) === tabClean ||
            cleanStr(itemName) === tabClean ||
            itemId === tabSlug ||
            itemId === tabLower ||
            (tabIso && itemIso && tabIso === itemIso)
          );
        });

        if (!matched) {
          matched = document.createElement('div');
          matched.className = 'dropdown-item';
          matched.setAttribute('data-country-id', tabSlug);
          matched.innerHTML = `<div class="item-content"><span class="item-name">${cleanName}</span></div>`;
        } else {
          matched.setAttribute('data-country-id', tabSlug);
          const nameSpan = matched.querySelector('.item-name');
          if (nameSpan) nameSpan.textContent = cleanName;
        }

        matched.style.display = 'flex';
        menu.appendChild(matched);
        usedElements.add(matched);
      });

      // Полностью удаляем элементы направлений, которых больше нет в активных вкладках Google Таблицы
      existingItems.forEach((item) => {
        if (!usedElements.has(item)) {
          item.remove();
        }
      });
    }

    // Instant local cache hydration to prevent flicker of deleted or reordered regions on reload
    try {
      const cachedTabs = localStorage.getItem('yacht_active_tabs_cache');
      if (cachedTabs) {
        const payload = JSON.parse(cachedTabs);
        if (payload && payload.activeNames && payload.activeNames.length > 0) {
          allowedCountries = new Set<string>(payload.activeNames.map((s: string) => s.toLowerCase().trim()));
        }
        if (payload && payload.activeTabs && Array.isArray(payload.activeTabs) && payload.activeTabs.length > 0) {
          reorderDropdownItems(payload.activeTabs);
          reorderGridCards(payload.activeTabs);
        }
      }
    } catch (e) {}

    function toggleDropdown(show?: boolean) {
      if (!menu || !trigger || !arrow) return;
      const isOpen = show !== undefined ? show : !menu.classList.contains('is-open');
      
      if (isOpen) {
        menu.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
        arrow.classList.add('rotated');
      } else {
        menu.classList.remove('is-open');
        trigger.setAttribute('aria-expanded', 'false');
        arrow.classList.remove('rotated');
      }
    }

    if (trigger) {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleDropdown();
      });
    }

    document.addEventListener('click', (e) => {
      if (dropdown && !dropdown.contains(e.target as Node)) {
        toggleDropdown(false);
      }
    });

    function updateYachtVisibility() {
      if (!grid) return;
      const showMoreBtnContainer = document.getElementById('show-more-container');

      const gridStyle = window.getComputedStyle(grid);
      const gridColumnsStr = gridStyle.getPropertyValue('grid-template-columns');
      let columnsCount = 1;
      if (gridColumnsStr && gridColumnsStr !== 'none') {
        const cols = gridColumnsStr.trim().split(/\s+/);
        columnsCount = cols.length;
      }
      
      const maxVisible = columnsCount * 2;

      // Always re-query all yacht cards dynamically
      const yachtCards = Array.from(grid.querySelectorAll<HTMLElement>('.yacht-card'));
      const matchingCards: HTMLElement[] = [];

      const filterLower = currentCountry.toLowerCase().trim();
      const filterClean = cleanStr(currentCountry);
      const filterTrans = transliterate(currentCountry);

      yachtCards.forEach((card) => {
        const cardCountryId = (card.getAttribute('data-country-id') || '').toLowerCase().trim();
        const cardCountryName = (card.getAttribute('data-country-name') || '').toLowerCase().trim();
        const cleanCardName = cleanStr(cardCountryName);
        const cleanCardId = cleanStr(cardCountryId);

        // Если получены активные страны и страна этой яхты удалена/пустая в Google Таблице — скрываем яхту
        if (allowedCountries && allowedCountries.size > 0) {
          const isAllowed = allowedCountries.has(cardCountryId) ||
                            allowedCountries.has(cardCountryName) ||
                            allowedCountries.has(cleanCardName) ||
                            allowedCountries.has(cleanCardId);
          if (!isAllowed) {
            card.style.display = 'none';
            return;
          }
        }

        const matchesFilter = filterLower === 'all' ||
                              cardCountryId === filterLower ||
                              cardCountryName === filterLower ||
                              cleanCardName === filterLower ||
                              cleanCardId === filterLower ||
                              cleanCardId === filterClean ||
                              cleanCardName === filterClean ||
                              (filterTrans && (cardCountryId === filterTrans || cleanCardId === cleanStr(filterTrans)));

        if (matchesFilter) {
          matchingCards.push(card);
        } else {
          card.style.display = 'none';
        }
      });

      matchingCards.forEach((card, index) => {
        if (isExpanded || index < maxVisible) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });

      if (showMoreBtnContainer) {
        if (matchingCards.length > maxVisible && !isExpanded) {
          showMoreBtnContainer.style.display = 'flex';
        } else {
          showMoreBtnContainer.style.display = 'none';
        }
      }

      if (emptyState) {
        emptyState.style.display = matchingCards.length === 0 ? 'flex' : 'none';
      }
    }

    function setFilter(countryId: string, customName?: string) {
      if (!countryId || countryId.toLowerCase().trim() === 'all') {
        currentCountry = 'all';
        currentCountryDisplayName = 'Все направления';
      } else {
        currentCountry = countryId;
        if (customName) {
          currentCountryDisplayName = customName;
        }
      }
      isExpanded = false;

      const filterLower = currentCountry.toLowerCase().trim();
      const filterClean = cleanStr(currentCountry);
      const filterTrans = transliterate(currentCountry);

      if (menu) {
        const dropdownItems = menu.querySelectorAll<HTMLElement>('.dropdown-item');
        let matchedText = '';

        dropdownItems.forEach((item) => {
          const itemId = (item.getAttribute('data-country-id') || '').toLowerCase().trim();
          const itemName = (item.querySelector('.item-name')?.textContent || '').toLowerCase().trim();
          const cleanItemId = cleanStr(itemId);
          const cleanItemName = cleanStr(itemName);

          const isMatch = filterLower === 'all'
            ? itemId === 'all'
            : (
                itemId === filterLower ||
                itemName === filterLower ||
                cleanItemId === filterClean ||
                cleanItemName === filterClean ||
                (filterTrans && (itemId === filterTrans || cleanItemId === cleanStr(filterTrans)))
              );

          if (isMatch) {
            item.classList.add('item-selected');
            matchedText = item.querySelector('.item-name')?.textContent?.trim() || '';
          } else {
            item.classList.remove('item-selected');
          }
        });

        if (triggerTitle) {
          if (filterLower === 'all') {
            triggerTitle.textContent = 'Все направления';
          } else if (matchedText) {
            triggerTitle.textContent = matchedText;
          } else {
            triggerTitle.textContent = currentCountryDisplayName || countryId;
          }
        }
      }

      updateYachtVisibility();
    }

