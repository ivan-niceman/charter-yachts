    // Auto-synchronize tabs from live Google Sheet
    async function syncYachtsForTabs(activeTabs: Array<{ name: string; gid: string }>) {
      if (!grid || !activeTabs || activeTabs.length === 0) return;

      const pubKey = DEFAULT_PUBLISHED_SHEET_KEY || '2PACX-1vQeRQ5VAaQfGuBuOl1AKIktnCubBKhDAcGlQD5-1PyqIJ8P5VR6HKjRxkYBQZrWzeHs1QD5XlA54GGl';

      for (const tab of activeTabs) {
        const { cleanName } = extractFlag(tab.name);
        const tabSlug = transliterate(cleanName) || cleanName.toLowerCase().replace(/[^a-z0-9]/g, '-');
        const cleanTab = cleanStr(cleanName);

        // Check if cards already exist for this country in the DOM
        const existingCards = Array.from(grid.querySelectorAll<HTMLElement>('.yacht-card'));
        const hasCard = existingCards.some(card => {
          const cId = (card.getAttribute('data-country-id') || '').toLowerCase().trim();
          const cName = (card.getAttribute('data-country-name') || '').toLowerCase().trim();
          const cleanCard = cleanStr(cName);
          return cId === tabSlug || cId === cleanTab || cleanCard === cleanTab || cName === cleanName.toLowerCase().trim();
        });

        if (hasCard) {
          loadedGids.add(tab.gid);
          continue;
        }

        if (loadedGids.has(tab.gid)) continue;
        loadedGids.add(tab.gid);

        try {
          const csvUrl = `https://docs.google.com/spreadsheets/d/e/${pubKey}/pub?gid=${tab.gid}&single=true&output=csv&t=${Date.now()}`;
          const res = await fetch(csvUrl, { cache: 'no-store' });
          if (!res.ok) continue;
          const csvText = await res.text();
          const rows = parseFullCSV(csvText);
          if (!rows || rows.length <= 1) continue;

          let flagColIdx = -1;
          let mapColIdx = -1;
          const headerRow = rows[0].map(c => (c || '').toLowerCase().trim());
          headerRow.forEach((col, idx) => {
            if (col === 'флаг' || col.includes('flag')) flagColIdx = idx;
            else if (col === 'карта' || col.includes('map')) mapColIdx = idx;
          });
          if (flagColIdx === -1) flagColIdx = 8;
          if (mapColIdx === -1) mapColIdx = 9;

          const tabYachts: any[] = [];
          let currentYacht: any = null;

          for (let i = 1; i < rows.length; i++) {
            const row = rows[i];
            let rawName = row[0]?.trim() || '';
            const descCell = row[1]?.trim() || '';
            const specName = row[2]?.trim() || '';
            const specVal = row[3]?.trim() || '';
            const accCell = row[4]?.trim() || '';
            const entCell = row[5]?.trim() || '';

            const urlsInRow: string[] = [];
            for (let colIdx = 0; colIdx < row.length; colIdx++) {
              if (colIdx === flagColIdx || colIdx === mapColIdx) continue;
              extractUrls(row[colIdx]).forEach((u: string) => {
                if (!urlsInRow.includes(u)) urlsInRow.push(u);
              });
            }

            rawName = rawName.replace(/^[,;\"'\s]+/, '').trim();
            const isFeature = knownFeatures.some(f => rawName.toLowerCase().startsWith(f));
            const isNewYachtHeader = rawName.length > 1 &&
              !rawName.startsWith('http') &&
              !rawName.startsWith('-') &&
              !isFeature &&
              (descCell.length > 20 || specName.toLowerCase() === 'длина' || !currentYacht);

            if (isNewYachtHeader) {
              if (currentYacht && currentYacht.name) {
                tabYachts.push(currentYacht);
              }
              currentYacht = {
                id: `${rawName.toLowerCase().replace(/[^a-z0-9]/g, '-')}-${tabSlug}`,
                name: rawName,
                countryId: tabSlug,
                countryName: cleanName,
                type: 'Премиум суперяхта',
                length: specName.toLowerCase() === 'длина' && specVal ? specVal : '50 м',
                capacity: '20 гостей',
                cabins: '10 кают',
                speed: '12 узлов',
                crew: 'Экипаж',
                images: [],
                description: descCell,
                accommodation: accCell,
                toysAndEntertainment: entCell ? [entCell] : [],
                specs: { year: '2026', engines: 'MAN', nitrox: 'Да', tender: 'Катер' }
              };
            }

            if (currentYacht) {
              if (specName && specVal) {
                const sLower = specName.toLowerCase();
                if (sLower.includes('длина')) currentYacht.length = specVal;
                else if (sLower.includes('ширина')) currentYacht.specs.tender = specVal;
                else if (sLower.includes('год')) currentYacht.specs.year = specVal;
                else if (sLower.includes('двигател')) currentYacht.specs.engines = specVal;
                else if (sLower.includes('скорост')) currentYacht.speed = specVal;
                else if (sLower.includes('кают')) currentYacht.cabins = `${specVal} кают`;
                else if (sLower.includes('вместимост')) currentYacht.capacity = `${specVal}`;
              }
              urlsInRow.forEach(u => {
                if (currentYacht) {
                  const isSpecificFile = /\.(jpe?g|png|webp|gif|svg|mp4|webm|mov|m4v)(\?.*)?$/i.test(u) ||
                                         u.includes('youtube.com/') || u.includes('youtu.be/') ||
                                         u.includes('rutube.ru/') || u.includes('vimeo.com/') || u.includes('vk.com/video') ||
                                         u.includes('charterindex.com') || u.includes('yacht.link') ||
                                         u.includes('yachtmaldives.com') || u.includes('drive.google.com/file') ||
                                         u.includes('lh3.googleusercontent.com');
                  const isFolder = !isSpecificFile && (
                    u.includes('/folders/') ||
                    u.includes('/drive/folders/') ||
                    (u.includes('disk.yandex.ru/d/') && !u.match(/\/[^\/]+\.[a-zA-Z0-9]+$/))
                  );
                  if (isFolder) {
                    currentYacht.driveFolderUrl = u;
                  } else {
                    const formatted = formatUniversalImageUrl(u);
                    if (formatted && !currentYacht.images.includes(formatted)) {
                      currentYacht.images.push(formatted);
                    }
                  }
                }
              });
              if (accCell && !currentYacht.accommodation?.includes(accCell) && !accCell.startsWith('http')) {
                currentYacht.accommodation = (currentYacht.accommodation ? currentYacht.accommodation + '\n' : '') + accCell;
              }
              if (entCell && !currentYacht.toysAndEntertainment?.includes(entCell) && !entCell.startsWith('http')) {
                if (!currentYacht.toysAndEntertainment) currentYacht.toysAndEntertainment = [];
                currentYacht.toysAndEntertainment.push(entCell);
              }
              if (descCell && !currentYacht.description.includes(descCell) && !descCell.startsWith('http')) {
                currentYacht.description += (currentYacht.description ? '\n' : '') + descCell;
              }
            }
          }

          if (currentYacht && currentYacht.name) {
            tabYachts.push(currentYacht);
          }

          // Resolve Yandex Disk URLs into direct CDN URLs
          for (const y of tabYachts) {
            if (y.images && y.images.length > 0) {
              const resolved: string[] = [];
              for (const img of y.images) {
                if (img.includes('disk.yandex.ru')) {
                  const direct = await resolveYandexDiskResource(img);
                  resolved.push(direct);
                } else {
                  resolved.push(img);
                }
              }
              y.images = resolved;
            }

            // Create and append dynamic YachtCard
            const cardEl = createDynamicYachtCard(y, cleanName);
            grid.appendChild(cardEl);

            // Create and append dynamic YachtModal
            if (modalsContainer) {
              const modalEl = createDynamicYachtModal(y, cleanName);
              modalsContainer.appendChild(modalEl);
              window.dispatchEvent(new CustomEvent('initDynamicModal', {
                detail: { modalId: `yacht-modal-${y.id}` }
              }));
            }
          }

          updateYachtVisibility();
        } catch (e) {
          console.error(`Failed to dynamically sync tab ${tab.name}:`, e);
        }
      }
    }

    window.addEventListener('syncActiveCountries', (e: any) => {
      if (e.detail && e.detail.activeNames && e.detail.activeNames.length > 0) {
        const activeNames: string[] = e.detail.activeNames.map((s: string) => s.toLowerCase().trim());
        allowedCountries = new Set<string>(activeNames);

        if (e.detail.activeTabs && Array.isArray(e.detail.activeTabs) && e.detail.activeTabs.length > 0) {
          if (menu) {
            reorderDropdownItems(e.detail.activeTabs);
          }
          reorderGridCards(e.detail.activeTabs);

          syncYachtsForTabs(e.detail.activeTabs).then(() => {
            reorderGridCards(e.detail.activeTabs);
          }).catch(() => {});
        }

        if (currentCountry !== 'all') {
          const currLower = currentCountry.toLowerCase().trim();
          const currClean = cleanStr(currentCountry);
          const currTrans = transliterate(currentCountry);
          const isAllowed = allowedCountries.has(currLower) ||
                            allowedCountries.has(currClean) ||
                            (currTrans && allowedCountries.has(currTrans));
          if (!isAllowed) {
            setFilter('all');
          } else {
            setFilter(currentCountry, currentCountryDisplayName);
          }
        } else {
          updateYachtVisibility();
        }
      }
    });

    // If active tabs were already discovered before this component initialized
    if ((window as any).__ACTIVE_TABS_DATA__) {
      const data = (window as any).__ACTIVE_TABS_DATA__;
      window.dispatchEvent(new CustomEvent('syncActiveCountries', { detail: data }));
    }

    window.addEventListener('selectCountryFilter', (e: any) => {
      if (e.detail) {
        const targetId = e.detail.countryId || e.detail.countryName;
        const targetName = e.detail.countryName || e.detail.countryId;
        if (targetId) {
          setFilter(targetId, targetName);
        }
      }
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      
      const detailsBtn = target.closest('.action-details');
      if (detailsBtn) {
        e.preventDefault();
        const yachtId = detailsBtn.getAttribute('data-details-id');
        if (yachtId) {
          window.dispatchEvent(new CustomEvent('openYachtDetails', {
            detail: { yachtId }
          }));
        }
        return;
      }

      const bookBtn = target.closest('.action-book');
      if (bookBtn) {
        e.preventDefault();
        const yachtName = bookBtn.getAttribute('data-book-yacht');
        if (yachtName) {
          window.dispatchEvent(new CustomEvent('openBooking', {
            detail: { yachtName }
          }));
        }
        return;
      }
    });
  });
</script>

