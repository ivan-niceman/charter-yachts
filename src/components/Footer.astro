---
import logo from '../assets/logo-b.svg?url';

const currentYear = new Date().getFullYear();

const navColumns = [
  {
    title: 'Направления',
    links: [
      { label: 'Мальдивы', href: '#destinations' },
      { label: 'Сейшелы', href: '#destinations' },
      { label: 'Греция', href: '#destinations' },
      { label: 'Хорватия', href: '#destinations' },
      { label: 'Дубай', href: '#destinations' },
      { label: 'Карибы', href: '#destinations' },
    ],
  },
  {
    title: 'Яхты',
    links: [
      { label: 'Моторные яхты', href: '#yachts' },
      { label: 'Парусные яхты', href: '#yachts' },
      { label: 'Катамараны', href: '#yachts' },
      { label: 'Суперяхты', href: '#yachts' },
    ],
  },
  {
    title: 'Компания',
    links: [
      { label: 'О нас', href: '#why-us' },
      { label: 'Услуги', href: '#booking' },
      { label: 'Отзывы', href: '#reviews' },
      { label: 'Контакты', href: '#contacts' },
    ],
  },
  {
    title: 'Информация',
    links: [
      { label: 'FAQ', href: '#faq' },
      { label: 'Условия', href: '#faq' },
      { label: 'Политика конфиденциальности', href: '#' },
    ],
  },
];
---

<footer class="footer" id="contacts">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="Абсолют-тур — На главную">
        <img src={logo} alt="Абсолют-тур" class="footer__logo-img" />
      </a>
    </div>

    {/* Колонки навигации */}
    <div class="footer__nav-grid">
      {navColumns.map((col) => (
        <div class="footer__col">
          <h4 class="footer__col-title">{col.title}</h4>
          <ul class="footer__col-list" role="list">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="footer__link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    {/* Телефон и социальные сети */}
    <div class="footer__contacts">
      <div class="footer__phone-block">
        <a href="tel:+78005559922" class="footer__phone">8 800 555 99 22</a>
        <span class="footer__hours">Ежедневно 10:00 – 20:00</span>
      </div>

      <div class="footer__socials">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="footer__social-btn" aria-label="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/>
          </svg>
        </a>

        <a href="https://t.me" target="_blank" rel="noopener noreferrer" class="footer__social-btn" aria-label="Telegram">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m22 2-7 20-4-9-9-4Z"/>
            <path d="M22 2 11 13"/>
          </svg>
        </a>

        <a href="https://wa.me" target="_blank" rel="noopener noreferrer" class="footer__social-btn" aria-label="WhatsApp">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/>
            <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/>
          </svg>
        </a>
      </div>
    </div>
    <p class="footer__copyright">
        © {currentYear} Абсолют-Тур. Все права защищены.
      </p>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-light);
    border-top: 1px solid var(--color-border);
    padding-block: 48px;
    font-size: 0.9rem;
    color: var(--color-navy);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 240px 1fr 220px;
    gap: 40px;
    align-items: start;
  }

  /* Логотип */
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  .footer__copyright {
    font-size: 0.8rem;
    color: var(--color-navy-light);
    line-height: 1.4;
    margin: 0;
  }

  /* Сетка навигации */
  .footer__nav-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  .footer__col-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 12px;
    margin-top: 0;
  }

  .footer__col-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer__link {
    text-decoration: none;
    color: var(--color-navy-light);
    font-size: 0.85rem;
    transition: color 0.2s ease;
  }

  .footer__link:hover {
    color: var(--color-orange);
  }

  /* Контакты и соцсети */
  .footer__contacts {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
  }

  .footer__phone-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .footer__phone {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-navy);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .footer__phone:hover {
    color: var(--color-orange);
  }

  .footer__hours {
    font-size: 0.75rem;
    color: var(--color-navy-light);
    margin-top: 2px;
  }

  .footer__socials {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer__social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    color: var(--color-navy);
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .footer__social-btn:hover {
    background-color: var(--color-orange-light);
    border-color: var(--color-orange);
    color: var(--color-orange);
    transform: translateY(-2px);
  }

  /* Адаптив */
  @media (max-width: 1100px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer__contacts {
      align-items: flex-start;
    }

    .footer__phone-block {
      align-items: flex-start;
    }
  }

  @media (max-width: 768px) {
    .footer__nav-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 480px) {
    .footer__nav-grid {
      grid-template-columns: 1fr;
    }
  }
</style>