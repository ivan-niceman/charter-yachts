---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const currentYear = new Date().getFullYear();

const navColumns = [
  {
    title: 'Компания',
    links: [
      { label: 'О нас', href: '/#about-us' },
      { label: 'Услуги', href: '/#booking' },
      { label: 'Отзывы', href: '/#reviews' },
      { label: 'Контакты', href: '/#contacts' },
    ],
  },
  {
    title: 'Информация',
    links: [
      { label: 'FAQ', href: '/#faq' },
      { label: 'Политика конфиденциальности', href: '/privacy' },
      { label: 'Настройки Cookie', href: '#', dataAttr: 'data-open-cookie-settings' },
    ],
  },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="Абсолют-тур — На главную">
        <Image src={logo} alt="Абсолют-тур" class="footer__logo-img" />
      </a>
    </div>

    <div class="footer__nav-grid">
      {navColumns.map((col) => (
        <div class="footer__col">
          <h4 class="footer__col-title">{col.title}</h4>
          <ul class="footer__col-list" role="list">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer__link"
                  {...(link.dataAttr ? { [link.dataAttr]: true } : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer__contacts">
      <div class="footer__phone-block">
        <a href="tel:+79313977103" class="footer__phone">+7 (931) 397-71-03</a>
        <a href="mailto:reservations@absolute-tour.com" class="footer__hours">reservations@absolute-tour.com</a>
      </div>

      <div class="footer__socials">
        <a href="https://t.me/+79313977103" target="_blank" rel="noopener noreferrer" class="footer__social-btn" aria-label="Telegram">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m22 2-7 20-4-9-9-4Z"/>
            <path d="M22 2 11 13"/>
          </svg>
        </a>

        <a href="https://wa.me/79313977103" target="_blank" rel="noopener noreferrer" class="footer__social-btn" aria-label="WhatsApp">
          <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/>
            <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/>
          </svg>
        </a>
        <a href="https://vk.com/absolute.tour" target="_blank" rel="noopener noreferrer" class="footer__social-btn" aria-label="Vkontakte">
          <svg width="25" height="25" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M27.55 35.19v-6.64c4.46.68 5.87 4.19 8.71 6.64h7.24a29.36 29.36 0 0 0-7.9-10.47c2.6-3.58 5.36-6.95 6.71-12.06h-6.58c-2.58 3.91-3.94 8.49-8.18 11.51V12.66H18l2.28 2.82v10.05c-3.7-.43-6.2-7.2-8.91-12.87H4.5C7 20.32 12.26 37.13 27.55 35.19Z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container">
      <p class="footer__copyright">
        © {currentYear} ООО «АБСОЛЮТ-ТУР».<br />Все права защищены.
      </p>
      <a href="https://nice-dev.ru/" class="nice-dev" target="_blank" rel="noopener noreferrer" aria-label="nice-dev.ru">© Nice Dev Web-Studio 2020 - {currentYear}</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-light);
    border-top: 1px solid var(--color-border);
    padding-top: 48px;
    padding-bottom: 0;
    font-size: 0.9rem;
    color: var(--color-navy);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    gap: 40px;
    align-items: start;
    padding-bottom: 32px;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__logo {
    width: fit-content;
  }

  .footer__logo-img {
    width: 120px;
    height: auto;
    object-fit: contain;
  }

  .footer__bottom {
    border-top: 1px solid var(--color-border);
    padding-block: 20px;
  }

  .footer__copyright {
    font-size: 0.8rem;
    color: var(--color-navy-light);
    line-height: 1.4;
    margin: 0;
    text-align: left;
  }

  .footer__nav-grid {
    display: flex;
    justify-content: space-between;
    gap: 28px;
  }

  .footer__col-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 12px;
    margin-top: 0;
  }

  .footer__col-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer__link {
    text-decoration: none;
    color: var(--color-navy-light);
    font-size: 0.85rem;
    transition: color 0.2s ease;
  }

  .footer__link:hover {
    color: var(--color-orange);
  }

  .footer__contacts {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 20px;
  }

  .footer__phone-block {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .footer__phone {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--color-navy);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .footer__phone:hover {
    color: var(--color-orange);
  }

  .footer__hours {
    font-size: 0.75rem;
    color: var(--color-navy-light);
    margin-top: 2px;
  }

  .footer__socials {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer__social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    color: var(--color-navy);
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .footer__social-btn:hover {
    background-color: var(--color-orange-light);
    border-color: var(--color-orange);
    color: var(--color-orange);
  }

  @media (max-width: 760px) {
    .footer__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .footer__brand {
      align-items: center;
      text-align: center;
    }

    .footer__contacts {
      align-items: center;
    }

    .footer__phone-block {
      align-items: flex-start;
    }
    .footer__nav-grid {
      justify-content: center;
    }
  }

  .nice-dev {
    display: block;
    margin: 30px auto 0;
    width: fit-content;
    font-size: 10px;
    color: #4e635f;
    animation: colorPulse 5s infinite;
  }

  .nice-dev:hover {
    animation: none;
    color: var(--color-orange);
  }

  @keyframes colorPulse {
    0%, 100% {
      color: rgba(78, 99, 95, 0.5);
    }
    50% {
      color: rgba(78, 99, 95);
    }
  }
</style>
