---
import type { Country } from '../lib/sheets';

interface Props {
  countries: Country[];
}

const { countries } = Astro.props;

const COUNTRY_FLAGS_MAP: Record<string, string> = {
  maldives: 'mv',
  indonesia: 'id',
  seychelles: 'sc',
  galapagos: 'ec',
  ecuador: 'ec',
  oman: 'om',
  palau: 'pw',
  egypt: 'eg',
  'costa-rica': 'cr',
  costarica: 'cr',
  russia: 'ru',
  thailand: 'th',
  turkey: 'tr',
  greece: 'gr',
  italy: 'it',
  spain: 'es',
  croatia: 'hr',
  norway: 'no',
  france: 'fr',
  montenegro: 'me',
  // Русские названия
  мальдивы: 'mv',
  индонезия: 'id',
  сейшелы: 'sc',
  галапагосы: 'ec',
  оман: 'om',
  палау: 'pw',
  египет: 'eg',
  'коста-рика': 'cr',
  костарика: 'cr',
  россия: 'ru',
  таиланд: 'th',
  тайланд: 'th',
  турция: 'tr',
  греция: 'gr',
  италия: 'it',
  испания: 'es',
  хорватия: 'hr',
  норвегия: 'no',
  франция: 'fr',
  черногория: 'me',
};

function emojiToCountryCode(emoji: string): string | null {
  if (!emoji) return null;
  const chars = [...emoji];
  if (chars.length >= 2) {
    const code1 = chars[0].codePointAt(0);
    const code2 = chars[1].codePointAt(0);
    if (code1 && code2 && code1 >= 0x1F1E6 && code1 <= 0x1F1FF && code2 >= 0x1F1E6 && code2 <= 0x1F1FF) {
      return (String.fromCharCode(code1 - 0x1F1E6 + 65) + String.fromCharCode(code2 - 0x1F1E6 + 65)).toLowerCase();
    }
  }
  return null;
}

function getCountryFlagUrl(country: Country): string {
  // 1. Если есть ссылка на флаг (из Google Таблицы / Google Drive / URL / локальный кэш)
  if (country.flag && (country.flag.startsWith('http://') || country.flag.startsWith('https://') || country.flag.startsWith('/'))) {
    return country.flag;
  }
  // 2. Если есть emoji флага
  if (country.flag) {
    const emojiCode = emojiToCountryCode(country.flag);
    if (emojiCode) {
      return `https://flagcdn.com/${emojiCode}.svg`;
    }
  }
  // 3. Автоматически по названию страны
  const idKey = (country.id || '').toLowerCase().trim();
  const nameKey = (country.name || '').toLowerCase().trim();
  const code = COUNTRY_FLAGS_MAP[idKey] || COUNTRY_FLAGS_MAP[nameKey];
  if (code) {
    return `https://flagcdn.com/${code}.svg`;
  }
  return '';
}

function getCountryCardBgUrl(country: Country): string {
  // 1. Если есть прямая ссылка на карту (из Google Таблицы / Google Drive / URL / локальный кэш)
  if (country.image && (country.image.startsWith('http://') || country.image.startsWith('https://') || country.image.startsWith('/'))) {
    return country.image;
  }
  return '';
}
---

<section id="destinations" class="section destinations-section">
  <div class="container">
    <!-- Header -->
    <div class="destinations-header section-header">
      <div>
        <span class="title">НАПРАВЛЕНИЯ</span>
        <h2 class="section-title">Популярные направления</h2>
      </div>
    </div>

    <!-- Destinations Grid -->
    <div class="destinations-grid-wrapper">
      <div class="destinations-grid" id="destinations-grid">
        {countries.map((country: Country) => {
          const flagUrl = getCountryFlagUrl(country);
          const bgUrl = getCountryCardBgUrl(country);
          return (
            <div
              class="compact-card"
              data-country-id={country.id}
              data-country-name={country.name}
              data-country-desc={country.description}
            >
              {bgUrl && (
                <div class="card-bg-img">
                  <img
                    src={bgUrl}
                    data-raw-src={country.image || bgUrl}
                    alt={`Карта ${country.name}`}
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    draggable="false"
                    onerror="if(window.repairYandexImage){window.repairYandexImage(this);}"
                  />
                </div>
              )}

              <!-- Top Row: Flag on left + Info button on right -->
              <div class="card-top-row">
                <div class="compact-flag-wrap" title={`Флаг: ${country.name}`}>
                  {flagUrl ? (
                    <img
                      src={flagUrl}
                      alt={`Флаг ${country.name}`}
                      class="compact-flag-img"
                      loading="lazy"
                      referrerpolicy="no-referrer"
                      onerror={`this.onerror=null; const code='${COUNTRY_FLAGS_MAP[(country.id || '').toLowerCase()] || COUNTRY_FLAGS_MAP[(country.name || '').toLowerCase()] || ''}'; if(code){ this.src='https://flagcdn.com/'+code+'.svg'; } else { this.style.display='none'; }`}
                    />
                  ) : (
                    <span class="compact-flag-emoji">{country.flag || '🏝️'}</span>
                  )}
                </div>

                <button
                  type="button"
                  class="compact-info-btn"
                  title="Информация о направлении"
                  aria-label={`Информация о направлении ${country.name}`}
                  data-info-btn
                  style={country.description ? 'display: flex;' : 'display: none;'}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                  </svg>
                </button>
              </div>

              <!-- Bottom Content: Country Name on top + "Смотреть яхты ->" underneath -->
              <div class="card-bottom-content">
                <h3 class="compact-country-name">{country.name}</h3>
                <div class="compact-action-hint">
                  <span>Смотреть яхты</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <script is:inline>
        (function() {
          try {
            var cachedTabs = localStorage.getItem('yacht_active_tabs_cache');
            if (cachedTabs) {
              var payload = JSON.parse(cachedTabs);
              if (payload && payload.activeNames && payload.activeNames.length > 0) {
                var allowed = {};
                payload.activeNames.forEach(function(n) {
                  var clean = (n || '').toLowerCase().replace(/[\u{1F300}-\u{1F9FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E6}-\u{1F1FF}]+/gu, '').replace(/[^a-zа-яё0-9]/gi, '').trim();
                  allowed[n.toLowerCase().trim()] = true;
                  allowed[clean] = true;
                });
                var grid = document.getElementById('destinations-grid');
                if (grid) {
                  var cards = grid.querySelectorAll('.compact-card');
                  cards.forEach(function(card) {
                    var cId = (card.getAttribute('data-country-id') || '').toLowerCase().trim();
                    var cName = (card.getAttribute('data-country-name') || '').toLowerCase().trim();
                    var cleanCName = (cName || '').replace(/[^a-zа-яё0-9]/gi, '').trim();
                    var cleanCId = (cId || '').replace(/[^a-zа-яё0-9]/gi, '').trim();
                    if (!allowed[cId] && !allowed[cName] && !allowed[cleanCName] && !allowed[cleanCId]) {
                      card.remove();
                    }
                  });
                }
              }
            }
          } catch(e) {}
        })();
      </script>
    </div>

    <!-- Show More / All Destinations Button (как в каталоге яхт) -->
    <div class="dest-show-more-container" id="dest-show-more-container" style="display: none;">
      <button type="button" class="dest-show-more-btn" id="dest-show-more-btn">
        <span>Все направления</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="btn-arrow">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <!-- Info Modal Popover -->
  <div class="info-modal-backdrop" id="destinations-modal" style="display: none;">
    <div class="info-modal-card">
      <button type="button" class="info-modal-close" id="destinations-modal-close" aria-label="Закрыть">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="info-modal-header">
        <h3 class="info-modal-title" id="destinations-modal-title">Мальдивы</h3>
      </div>
      <p class="info-modal-text" id="destinations-modal-text"></p>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Shared state and lookup tables
    const dynamicRegionDesc: Record<string, string> = {};
    let isDestExpanded = false;

    function cleanStr(s: string): string {
      return (s || '')
        .toLowerCase()
        .replace(/[\u{1F300}-\u{1F9FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E6}-\u{1F1FF}]+/gu, '')
        .replace(/[^a-zа-яё0-9]/gi, '')
        .trim();
    }

    function transliterate(text: string): string {
      const map: Record<string, string> = {
        'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd', 'е': 'e', 'ё': 'yo', 'ж': 'zh',
        'з': 'z', 'и': 'i', 'й': 'y', 'к': 'k', 'л': 'l', 'м': 'm', 'н': 'n', 'о': 'o',
        'п': 'p', 'р': 'r', 'с': 's', 'т': 't', 'у': 'u', 'ф': 'f', 'х': 'kh', 'ц': 'ts',
        'ч': 'ch', 'ш': 'sh', 'щ': 'shch', 'ъ': '', 'ы': 'y', 'ь': '', 'э': 'e', 'ю': 'yu', 'я': 'ya'
      };
      return text.toLowerCase().split('').map(char => map[char] || char).join('').replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
    }

    function getCountriesCountText(n: number): string {
      const mod10 = n % 10;
      const mod100 = n % 100;
      if (mod100 >= 11 && mod100 <= 19) return `${n} стран`;
      if (mod10 === 1) return `${n} страна`;
      if (mod10 >= 2 && mod10 <= 4) return `${n} страны`;
      return `${n} стран`;
    }

    const CLIENT_FLAGS_MAP: Record<string, string> = {
      maldives: 'mv', indonesia: 'id', seychelles: 'sc', galapagos: 'ec', ecuador: 'ec',
      oman: 'om', palau: 'pw', egypt: 'eg', 'costa-rica': 'cr', costarica: 'cr',
      russia: 'ru', thailand: 'th', turkey: 'tr', greece: 'gr', italy: 'it', spain: 'es',
      croatia: 'hr', norway: 'no', france: 'fr', montenegro: 'me',
      мальдивы: 'mv', индонезия: 'id', сейшелы: 'sc', галапагосы: 'ec',
      оман: 'om', палау: 'pw', египет: 'eg', 'коста-рика': 'cr', костарика: 'cr',
      россия: 'ru', таиланд: 'th', тайланд: 'th', турция: 'tr', греция: 'gr',
      италия: 'it', испания: 'es', хорватия: 'hr', норвегия: 'no', франция: 'fr', черногория: 'me'
    };

    // --- Info Modal Popover ---
    const modal = document.getElementById('destinations-modal') as HTMLDivElement | null;
    const modalClose = document.getElementById('destinations-modal-close') as HTMLButtonElement | null;
    const modalTitle = document.getElementById('destinations-modal-title') as HTMLHeadingElement | null;
    const modalText = document.getElementById('destinations-modal-text') as HTMLParagraphElement | null;

    function openDestinationsModal(title: string, desc: string) {
      if (!modal || !modalTitle || !modalText) return;
      modalTitle.textContent = title;
      modalText.textContent = desc;
      modalText.scrollTop = 0;
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeDestinationsModal() {
      if (modal) {
        modal.style.display = 'none';
      }
      document.body.style.overflow = '';
    }

    modalClose?.addEventListener('click', closeDestinationsModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeDestinationsModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.style.display !== 'none') {
        closeDestinationsModal();
      }
    });

    // --- Grid Visibility & Columns Logic (5 на десктопе, 3 на планшете, 2 на мобиле) ---
    function getDestColumnsCount(): number {
      if (window.innerWidth <= 640) return 2;
      if (window.innerWidth <= 1024) return 3;
      return 5;
    }

    function updateDestinationsVisibility() {
      const grid = document.getElementById('destinations-grid');
      if (!grid) return;
      const showMoreContainer = document.getElementById('dest-show-more-container');
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.compact-card'));
      const maxVisible = getDestColumnsCount();

      cards.forEach((card, index) => {
        if (isDestExpanded || index < maxVisible) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });

      if (showMoreContainer) {
        if (cards.length > maxVisible && !isDestExpanded) {
          showMoreContainer.style.display = 'flex';
        } else {
          showMoreContainer.style.display = 'none';
        }
      }
    }

    const destShowMoreBtn = document.getElementById('dest-show-more-btn');
    if (destShowMoreBtn) {
      destShowMoreBtn.addEventListener('click', () => {
        isDestExpanded = true;
        updateDestinationsVisibility();
      });
    }

    let resizeTimer: any;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        updateDestinationsVisibility();
      }, 100);
    });

    // --- Dynamic Background Sync from Google Sheets ---
    let PUBLISHED_KEY =
      (typeof import.meta !== 'undefined' && import.meta.env && import.meta.env.PUBLIC_GOOGLE_PUBLISHED_KEY) || '';
    let REGIONS_GID =
      (typeof import.meta !== 'undefined' && import.meta.env && import.meta.env.PUBLIC_GOOGLE_REGIONS_GID) || '0';

    function parseSimpleCSV(text: string): string[][] {
      const rows: string[][] = [];
      let currentRow: string[] = [];
      let currentCell = '';
      let inQuotes = false;
      for (let i = 0; i < text.length; i++) {
        const char = text[i];
        const nextChar = text[i + 1];
        if (char === '"') {
          if (inQuotes && nextChar === '"') {
            currentCell += '"';
            i++;
          } else {
            inQuotes = !inQuotes;
          }
        } else if (char === ',' && !inQuotes) {
          currentRow.push(currentCell);
          currentCell = '';
        } else if ((char === '\r' || char === '\n') && !inQuotes) {
          if (char === '\r' && nextChar === '\n') i++;
          currentRow.push(currentCell);
          if (currentRow.some(c => c.trim() !== '')) rows.push(currentRow);
          currentRow = [];
          currentCell = '';
        } else {
          currentCell += char;
        }
      }
      if (currentCell || currentRow.length > 0) {
        currentRow.push(currentCell);
        if (currentRow.some(c => c.trim() !== '')) rows.push(currentRow);
      }
      return rows;
    }

    function extractUrls(str: string): string[] {
      if (!str) return [];
      const rawMatches = str.match(/https?:\/\/[^\s\"]+/g) || [];
      const urls: string[] = [];
      for (const match of rawMatches) {
        const parts = match.split(/(?=https?:\/\/)/).map(u => u.trim()).filter(Boolean);
        for (let p of parts) {
          p = p.replace(/[,;]+$/, '');
          if (p) urls.push(p);
        }
      }
      return urls;
    }

    function formatGoogleDriveImageUrl(url: string): string {
      if (!url || typeof url !== 'string') return '';
      const trimmed = url.trim();
      if (!trimmed) return '';

      const yachtLinkMatch =
        trimmed.match(/yacht\.link\/[^\/]+\/gallery\.html#([a-zA-Z0-9_-]+)/i) ||
        trimmed.match(/yacht\.link\/.*#([a-zA-Z0-9_-]+)/i);
      if (yachtLinkMatch && yachtLinkMatch[1]) {
        return `https://images.charterindex.com/${yachtLinkMatch[1]}.jpg`;
      }

      const driveMatch = trimmed.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/) || 
                         trimmed.match(/drive\.google\.com\/thumbnail\?.*id=([a-zA-Z0-9_-]+)/) ||
                         trimmed.match(/lh3\.google\.com\/u\/\d+\/d\/([a-zA-Z0-9_-]+)/) ||
                         trimmed.match(/lh3\.googleusercontent\.com\/d\/([a-zA-Z0-9_-]+)/) ||
                         trimmed.match(/drive\.google\.com\/open\?id=([a-zA-Z0-9_-]+)/) ||
                         trimmed.match(/drive\.google\.com\/uc\?.*id=([a-zA-Z0-9_-]+)/) ||
                         trimmed.match(/docs\.google\.com\/uc\?.*id=([a-zA-Z0-9_-]+)/);

      if (driveMatch && driveMatch[1]) {
        const fileId = driveMatch[1].replace(/=w\d+/, '');
        if (trimmed.toLowerCase().endsWith('.svg') || trimmed.toLowerCase().includes('.svg')) {
          return `https://drive.google.com/uc?export=view&id=${fileId}`;
        }
        return `https://lh3.googleusercontent.com/d/${fileId}=w1400`;
      }

      return trimmed;
    }

    function isPublicYandexDiskLink(url: string): boolean {
      return /^https?:\/\/disk\.yandex\.ru\//i.test((url || '').trim());
    }

    function bindCardEvents(card: HTMLElement) {
      const countryId = card.getAttribute('data-country-id') || '';
      const countryName = card.getAttribute('data-country-name') || '';
      const infoBtn = card.querySelector('[data-info-btn]');

      if (infoBtn) {
        infoBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const cleanKey = cleanStr(countryName);
          const dynamicDesc = cleanKey ? dynamicRegionDesc[cleanKey] : null;
          const fallbackDesc = card.getAttribute('data-country-desc');
          const finalDesc = dynamicDesc || fallbackDesc || '';

          if (!finalDesc) return;
          openDestinationsModal(countryName, finalDesc);
        });
      }

      card.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('selectCountryFilter', { detail: { countryId, countryName } }));
        const yachtsElem = document.getElementById('yachts');
        if (yachtsElem) {
          yachtsElem.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    function createSingleCard(item: { name: string; id: string; desc: string; flagUrl?: string; bgUrl?: string }): HTMLElement {
      const card = document.createElement('div');
      card.className = 'compact-card';
      card.setAttribute('data-country-id', item.id);
      card.setAttribute('data-country-name', item.name);
      card.setAttribute('data-country-desc', item.desc);

      const hasDesc = Boolean(item.desc);
      const cleanKey = cleanStr(item.name) || cleanStr(item.id);
      const flagCode = CLIENT_FLAGS_MAP[cleanKey] || CLIENT_FLAGS_MAP[item.id.toLowerCase()] || CLIENT_FLAGS_MAP[item.name.toLowerCase()] || '';
      const flagUrl = item.flagUrl || (flagCode ? `https://flagcdn.com/${flagCode}.svg` : '');
      const bgUrl = item.bgUrl || '';
      const directBg = (window as any).__yandexDirectCache?.[bgUrl] || (bgUrl.includes('disk.yandex.ru') ? '' : bgUrl);

      card.innerHTML = `
        ${bgUrl ? `
          <div class="card-bg-img">
            <img
              src="${directBg}"
              data-raw-src="${bgUrl}"
              alt="Фон ${item.name}"
              loading="lazy"
              referrerpolicy="no-referrer"
              onerror="if(window.repairYandexImage){window.repairYandexImage(this);}"
            />
          </div>
        ` : ''}
        <div class="card-top-row">
          <div class="compact-flag-wrap" title="Флаг: ${item.name}">
            ${flagUrl ? `<img src="${flagUrl}" alt="Флаг ${item.name}" class="compact-flag-img" loading="lazy" onerror="this.style.display='none'" />` : '<span class="compact-flag-emoji">🏝️</span>'}
          </div>
          <button
            type="button"
            class="compact-info-btn"
            title="Информация о направлении"
            aria-label="Информация о направлении ${item.name}"
            data-info-btn
            style="${hasDesc ? 'display: flex;' : 'display: none;'}"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </button>
        </div>
        <div class="card-bottom-content">
          <h3 class="compact-country-name">${item.name}</h3>
          <div class="compact-action-hint">
            <span>Смотреть яхты</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </div>
      `;

      if (bgUrl && !directBg && (bgUrl.includes('disk.yandex.ru') || bgUrl.includes('downloader.disk.yandex.ru'))) {
        const bgImg = card.querySelector<HTMLImageElement>('.card-bg-img img');
        if (bgImg && (window as any).repairYandexImage) {
          (window as any).repairYandexImage(bgImg);
        }
      }

      bindCardEvents(card);
      return card;
    }

    function reorderDestinations(activeTabs: { name: string; gid: string }[]) {
      const gridEl = document.getElementById('destinations-grid');
      if (!gridEl || !activeTabs || !Array.isArray(activeTabs) || activeTabs.length === 0) return;
      const existingDOMCards = Array.from(gridEl.querySelectorAll<HTMLElement>('.compact-card'));
      if (existingDOMCards.length === 0) return;

      const uniqueCards = new Map<string, HTMLElement>();
      existingDOMCards.forEach((c) => {
        const name = c.getAttribute('data-country-name') || '';
        const id = c.getAttribute('data-country-id') || '';
        const key = cleanStr(name) || cleanStr(id);
        const trans = transliterate(name);
        const iso = CLIENT_FLAGS_MAP[key] || CLIENT_FLAGS_MAP[cleanStr(id)] || '';
        if (key && !uniqueCards.has(key)) uniqueCards.set(key, c);
        if (trans && !uniqueCards.has(trans)) uniqueCards.set(trans, c);
        if (iso && !uniqueCards.has('iso:' + iso)) uniqueCards.set('iso:' + iso, c);
      });

      const orderedCards: HTMLElement[] = [];
      const orderedMeta: { name: string; id: string; desc: string; flagUrl?: string; bgUrl?: string }[] = [];

      activeTabs.forEach(tab => {
        const raw = tab.name || '';
        const cleanName = raw.replace(/[\u{1F300}-\u{1F9FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E6}-\u{1F1FF}]+/gu, '').trim();
        const cleanKey = cleanStr(cleanName);
        const trans = transliterate(cleanName);
        const iso = CLIENT_FLAGS_MAP[cleanKey] || CLIENT_FLAGS_MAP[trans] || '';
        const found = uniqueCards.get(cleanKey) ||
                      uniqueCards.get(trans) ||
                      (iso ? uniqueCards.get('iso:' + iso) : undefined);
        if (found) {
          orderedCards.push(found);
          orderedMeta.push({
            name: found.getAttribute('data-country-name') || cleanName,
            id: found.getAttribute('data-country-id') || trans,
            desc: found.getAttribute('data-country-desc') || ''
          });
        } else {
          const newCard = createSingleCard({
            name: cleanName,
            id: trans || cleanKey,
            desc: dynamicRegionDesc[cleanKey] || ''
          });
          orderedCards.push(newCard);
          orderedMeta.push({
            name: cleanName,
            id: trans || cleanKey,
            desc: dynamicRegionDesc[cleanKey] || ''
          });
        }
      });

      if (orderedCards.length > 0) {
        gridEl.innerHTML = '';
        orderedCards.forEach((card) => {
          bindCardEvents(card);
          gridEl.appendChild(card);
        });
        updateDestinationsVisibility();
      }
    }

    // Instant local cache hydration to prevent flicker on reload
    try {
      const cached = localStorage.getItem('yacht_destinations_cache');
      const cachedTabs = localStorage.getItem('yacht_active_tabs_cache');
      const gridEl = document.getElementById('destinations-grid');

      if (cached && gridEl) {
        const list = JSON.parse(cached);
        const hasUnresolvedYandexMaps = Array.isArray(list) && list.some((item: any) => isPublicYandexDiskLink(item?.bgUrl));
        const hasServerRenderedCards = Boolean(gridEl.querySelector('.compact-card'));
        if (Array.isArray(list) && list.length > 0 && !hasUnresolvedYandexMaps && !hasServerRenderedCards) {
          gridEl.innerHTML = '';
          list.forEach((item: any) => {
            const newCard = createSingleCard(item);
            gridEl.appendChild(newCard);
          });
          updateDestinationsVisibility();
        }
      }
      if (cachedTabs) {
        const payload = JSON.parse(cachedTabs);
        (window as any).__ACTIVE_TABS_DATA__ = payload;
        if (payload.activeTabs && Array.isArray(payload.activeTabs) && payload.activeTabs.length > 0) {
          reorderDestinations(payload.activeTabs);
        }
        window.dispatchEvent(new CustomEvent('syncActiveCountries', { detail: payload }));
      }
    } catch (e) {}

    // Initialize initial visibility
    updateDestinationsVisibility();

    // Fetch dynamic config.json first (allowing updates without build), then Google Sheets
    async function loadLiveData() {
      try {
        const cfgRes = await fetch(`/config.json?t=${Date.now()}`, { cache: 'no-store' });
        if (cfgRes.ok) {
          const cfg = await cfgRes.json();
          if (cfg.PUBLIC_GOOGLE_PUBLISHED_KEY) PUBLISHED_KEY = cfg.PUBLIC_GOOGLE_PUBLISHED_KEY;
          if (cfg.PUBLIC_GOOGLE_REGIONS_GID) REGIONS_GID = String(cfg.PUBLIC_GOOGLE_REGIONS_GID);
        }
      } catch (e) {}

      if (!PUBLISHED_KEY) return;

      const [pubHtml, csvText] = await Promise.all([
        fetch(`https://docs.google.com/spreadsheets/d/e/${PUBLISHED_KEY}/pubhtml?t=${Date.now()}`, { cache: 'no-store' })
          .then(r => r.ok ? r.text() : '').catch(() => ''),
        fetch(`https://docs.google.com/spreadsheets/d/e/${PUBLISHED_KEY}/pub?gid=${REGIONS_GID}&single=true&output=csv&t=${Date.now()}`, { cache: 'no-store' })
          .then(r => r.ok ? r.text() : '').catch(() => '')
      ]);

      const detectedTabs: { name: string; gid: string }[] = [];

      if (pubHtml) {
        const regex = /name:\s*"([^"]+)",\s*pageUrl:\s*"[^"]*",\s*gid:\s*"([^"]+)"/g;
        let match;
        const ignore = ['регионы', 'regions', 'общаяинфаfaq', 'общаяинфа', 'faq', 'отзывыклиентов', 'отзывы', 'reviews'];
        while ((match = regex.exec(pubHtml)) !== null) {
          const rawName = match[1]
            .replace(/\\x26/g, '&').replace(/\\x27/g, "'").replace(/\\x22/g, '"')
            .replace(/\\u([0-9a-fA-F]{4})/g, (_, c) => String.fromCharCode(parseInt(c, 16)))
            .replace(/\\/g, '');
          const key = cleanStr(rawName);
          if (key && !ignore.includes(key)) {
            detectedTabs.push({ name: rawName.trim(), gid: match[2] });
          }
        }
      }

      if (csvText) {
        const rows = parseSimpleCSV(csvText);
        for (const row of rows) {
          const descCell = String(row[0] || '').trim();
          if (!descCell || descCell === 'Описание региона' || descCell.toLowerCase().startsWith('http')) continue;
          const lines = descCell.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
          if (lines.length === 0) continue;
          const cleanName = cleanStr(lines[0]);
          if (!cleanName || cleanName === 'название' || cleanName.length < 2) continue;
          const desc = lines.slice(1).join('\n').trim();
          if (desc) {
            dynamicRegionDesc[cleanName] = desc;
          }
        }
      }

      const tabDataPromises = detectedTabs.map(async (tab) => {
        try {
          const res = await fetch(`https://docs.google.com/spreadsheets/d/e/${PUBLISHED_KEY}/pub?gid=${tab.gid}&single=true&output=csv&t=${Date.now()}`, { cache: 'no-store' });
          if (!res.ok) return null;
          const text = await res.text();
          const rows = parseSimpleCSV(text);
          let yachtCount = 0;
          let tabFlag = '';
          let tabMap = '';

          for (let i = 0; i < rows.length; i++) {
            const row = rows[i];
            const nameCell = String(row[0] || '').trim();
            if (nameCell && nameCell !== 'Яхта' && nameCell !== 'Название' && !nameCell.toLowerCase().startsWith('http') && !nameCell.toLowerCase().includes('описание')) {
              yachtCount++;
            }
            const flagCell = String(row[8] || '').trim();
            if (flagCell && !tabFlag) {
              const urls = extractUrls(flagCell);
              if (urls.length > 0) tabFlag = formatGoogleDriveImageUrl(urls[0]);
            }
            const mapCell = String(row[9] || '').trim();
            if (mapCell && !tabMap) {
              const urls = extractUrls(mapCell);
              if (urls.length > 0) {
                tabMap = formatGoogleDriveImageUrl(urls[0]);
              }
            }
          }

          if (yachtCount === 0) {
            return null;
          }

          return {
            tab,
            yachtCount,
            flagUrl: tabFlag,
            bgUrl: tabMap
          };
        } catch (e) {
          return null;
        }
      });

      const tabResults = await Promise.all(tabDataPromises);
      const validTabs = tabResults.filter((r): r is NonNullable<typeof r> => r !== null);
      const activeTabsList = validTabs.map(r => r.tab);
      const gridEl = document.getElementById('destinations-grid');

      if (validTabs.length > 0 && gridEl) {
        const existingDOMCards = Array.from(gridEl.querySelectorAll<HTMLElement>('.compact-card'));
        const uniqueDOMCountries = new Map<string, { name: string; id: string; desc: string; flagUrl?: string; bgUrl?: string; html?: HTMLElement }>();

        existingDOMCards.forEach((c) => {
          const name = c.getAttribute('data-country-name') || '';
          const id = c.getAttribute('data-country-id') || '';
          const desc = c.getAttribute('data-country-desc') || '';
          const bgUrl = c.querySelector<HTMLImageElement>('.card-bg-img img')?.src || '';
          const key = cleanStr(name) || cleanStr(id);
          const trans = transliterate(name);
          const iso = CLIENT_FLAGS_MAP[key] || CLIENT_FLAGS_MAP[cleanStr(id)] || '';
          if (key && !uniqueDOMCountries.has(key)) {
            uniqueDOMCountries.set(key, { name, id, desc, bgUrl, html: c as HTMLElement });
          }
          if (trans && !uniqueDOMCountries.has(trans)) {
            uniqueDOMCountries.set(trans, { name, id, desc, bgUrl, html: c as HTMLElement });
          }
          if (iso && !uniqueDOMCountries.has('iso:' + iso)) {
            uniqueDOMCountries.set('iso:' + iso, { name, id, desc, bgUrl, html: c as HTMLElement });
          }
        });

        const finalList: { name: string; id: string; desc: string; flagUrl?: string; bgUrl?: string; html?: HTMLElement }[] = [];
        validTabs.forEach(({ tab, flagUrl, bgUrl }) => {
          const key = cleanStr(tab.name);
          const trans = transliterate(tab.name);
          const iso = CLIENT_FLAGS_MAP[key] || CLIENT_FLAGS_MAP[trans] || '';
          const desc = dynamicRegionDesc[key] || '';
          const existing = uniqueDOMCountries.get(key) || uniqueDOMCountries.get(trans) || (iso ? uniqueDOMCountries.get('iso:' + iso) : undefined);

          const finalBg = (existing && existing.bgUrl) ? existing.bgUrl : (bgUrl || '');

          if (existing) {
            finalList.push({
              ...existing,
              name: tab.name,
              id: existing.id || trans || key,
              desc: desc || existing.desc,
              flagUrl: flagUrl || existing.flagUrl,
              bgUrl: finalBg
            });
          } else {
            finalList.push({
              name: tab.name,
              id: trans || key,
              desc,
              flagUrl,
              bgUrl: finalBg
            });
          }
        });

        gridEl.innerHTML = '';
        finalList.forEach((item) => {
          if (item.html && !item.flagUrl && !item.bgUrl) {
            const clone = item.html.cloneNode(true) as HTMLElement;
            bindCardEvents(clone);
            gridEl.appendChild(clone);
          } else {
            const newCard = createSingleCard(item);
            gridEl.appendChild(newCard);
          }
        });

        updateDestinationsVisibility();

        const allActiveKeys = new Set<string>();
        validTabs.forEach(r => {
          const rawName = (r.tab.name || '').toLowerCase().trim();
          const cleanKey = cleanStr(r.tab.name);
          const trans = transliterate(r.tab.name);
          const iso = CLIENT_FLAGS_MAP[cleanKey] || CLIENT_FLAGS_MAP[trans] || '';
          if (rawName) allActiveKeys.add(rawName);
          if (cleanKey) allActiveKeys.add(cleanKey);
          if (trans) allActiveKeys.add(trans);
          if (iso) {
            allActiveKeys.add(iso);
            allActiveKeys.add('iso:' + iso);
          }
        });

        const activeTabsPayload = { activeNames: Array.from(allActiveKeys), activeTabs: activeTabsList };
        (window as any).__ACTIVE_TABS_DATA__ = activeTabsPayload;
        try {
          localStorage.setItem('yacht_destinations_cache', JSON.stringify(finalList.map(f => ({ name: f.name, id: f.id, desc: f.desc, flagUrl: f.flagUrl, bgUrl: f.bgUrl }))));
          localStorage.setItem('yacht_active_tabs_cache', JSON.stringify(activeTabsPayload));
        } catch (e) {}

        window.dispatchEvent(new CustomEvent('syncActiveCountries', {
          detail: activeTabsPayload
        }));
      }

      if (gridEl) {
        gridEl.querySelectorAll('.compact-card').forEach((card) => {
          const cName = cleanStr(card.getAttribute('data-country-name') || '');
          const infoBtn = card.querySelector<HTMLElement>('[data-info-btn]');
          const hasDesc = Boolean(cName && dynamicRegionDesc[cName]);
          if (infoBtn) {
            infoBtn.style.display = hasDesc ? 'flex' : 'none';
          }
        });
      }
    }

    loadLiveData().catch((err) => {
      console.error('Destinations dynamic sync error:', err);
    });

    const initGrid = document.getElementById('destinations-grid');
    initGrid?.querySelectorAll<HTMLElement>('.compact-card').forEach(bindCardEvents);
  });
</script>

