---
import type { Country } from '../lib/sheets';
import ImagePreloader from './ImagePreloader.astro';

interface Props {
  countries: Country[];
}

const { countries } = Astro.props;

const COUNTRY_FLAGS_MAP: Record<string, string> = {
  maldives: 'mv',
  indonesia: 'id',
  seychelles: 'sc',
  galapagos: 'ec',
  ecuador: 'ec',
  oman: 'om',
  palau: 'pw',
  egypt: 'eg',
  'costa-rica': 'cr',
  costarica: 'cr',
  russia: 'ru',
  thailand: 'th',
  turkey: 'tr',
  greece: 'gr',
  italy: 'it',
  spain: 'es',
  croatia: 'hr',
  norway: 'no',
  france: 'fr',
  montenegro: 'me',
  // Русские названия
  мальдивы: 'mv',
  индонезия: 'id',
  сейшелы: 'sc',
  галапагосы: 'ec',
  оман: 'om',
  палау: 'pw',
  египет: 'eg',
  'коста-рика': 'cr',
  костарика: 'cr',
  россия: 'ru',
  таиланд: 'th',
  тайланд: 'th',
  турция: 'tr',
  греция: 'gr',
  италия: 'it',
  испания: 'es',
  хорватия: 'hr',
  норвегия: 'no',
  франция: 'fr',
  черногория: 'me',
};

function emojiToCountryCode(emoji: string): string | null {
  if (!emoji) return null;
  const chars = [...emoji];
  if (chars.length >= 2) {
    const code1 = chars[0].codePointAt(0);
    const code2 = chars[1].codePointAt(0);
    if (code1 && code2 && code1 >= 0x1F1E6 && code1 <= 0x1F1FF && code2 >= 0x1F1E6 && code2 <= 0x1F1FF) {
      return (String.fromCharCode(code1 - 0x1F1E6 + 65) + String.fromCharCode(code2 - 0x1F1E6 + 65)).toLowerCase();
    }
  }
  return null;
}

function getCountryFlagUrl(country: Country): string {
  // 1. Если есть ссылка на флаг (из Google Таблицы / Google Drive / URL) - ВСЕГДА используем именно её!
  if (country.flag && (country.flag.startsWith('http://') || country.flag.startsWith('https://'))) {
    return country.flag;
  }
  // 2. Если есть emoji флага
  if (country.flag) {
    const emojiCode = emojiToCountryCode(country.flag);
    if (emojiCode) {
      return `https://flagcdn.com/${emojiCode}.svg`;
    }
  }
  // 3. Автоматически по названию страны
  const idKey = (country.id || '').toLowerCase().trim();
  const nameKey = (country.name || '').toLowerCase().trim();
  const code = COUNTRY_FLAGS_MAP[idKey] || COUNTRY_FLAGS_MAP[nameKey];
  if (code) {
    return `https://flagcdn.com/${code}.svg`;
  }
  return '';
}

function getCountryCardBgUrl(country: Country): string {
  // 1. Если есть прямая ссылка на карту (из Google Таблицы / Google Drive / URL)
  if (country.image && (country.image.startsWith('http://') || country.image.startsWith('https://'))) {
    return country.image;
  }
  // 2. Если ссылки на карту нет — загружаем вместо карты флаг
  return getCountryFlagUrl(country);
}

// Тройное клонирование списка для бесшовной бесконечной прокрутки
const displayItems = countries.length > 1 ? [...countries, ...countries, ...countries] : [...countries];
const L = countries.length;
---

<section id="destinations" class="section destinations-section">
  <div class="container">
    <!-- Header -->
    <div class="destinations-header section-header">
      <div>
        <span class="title">НАПРАВЛЕНИЯ</span>
        <h2 class="section-title">Популярные направления</h2>
      </div>

      <a href="#yachts" class="view-all-link" title="Смотреть все направления">
        Смотреть все направления
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <div class="slider-wrapper">
      <div class="slider-track" id="destinations-slider-track" data-length={L} data-count={countries.length}>
        {displayItems.map((country: Country) => {
          const flagUrl = getCountryFlagUrl(country);
          const bgUrl = getCountryCardBgUrl(country);
          return (
            <div
              class="compact-card"
              data-country-id={country.id}
              data-country-name={country.name}
              data-country-desc={country.description}
            >
              {bgUrl && (
                <ImagePreloader
                  src={bgUrl}
                  alt={`Карта ${country.name}`}
                  class="card-bg-img"
                />
              )}

              <!-- Top Row: Flag on left + Info button on right -->
              <div class="card-top-row">
                <div class="compact-flag-wrap" title={`Флаг: ${country.name}`}>
                  {flagUrl ? (
                    <img
                      src={flagUrl}
                      alt={`Флаг ${country.name}`}
                      class="compact-flag-img"
                      loading="lazy"
                      referrerpolicy="no-referrer"
                      onerror={`this.onerror=null; const code='${COUNTRY_FLAGS_MAP[(country.id || '').toLowerCase()] || COUNTRY_FLAGS_MAP[(country.name || '').toLowerCase()] || ''}'; if(code){ this.src='https://flagcdn.com/'+code+'.svg'; } else { this.style.display='none'; }`}
                    />
                  ) : (
                    <span class="compact-flag-emoji">{country.flag || '🏝️'}</span>
                  )}
                </div>

                <button
                  type="button"
                  class="compact-info-btn"
                  title="Информация о направлении"
                  aria-label={`Информация о направлении ${country.name}`}
                  data-info-btn
                  style={country.description ? 'display: flex;' : 'display: none;'}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                  </svg>
                </button>
              </div>

              <!-- Bottom Content: Country Name on top + "Смотреть яхты ->" underneath -->
              <div class="card-bottom-content">
                <h3 class="compact-country-name">{country.name}</h3>
                <div class="compact-action-hint">
                  <span>Смотреть яхты</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <div class="slider-controls-footer">
      <div class="pagination-dots" id="destinations-dots">
      </div>

      <div class="nav-arrows">
        <button type="button" class="nav-arrow-btn" id="destinations-prev" aria-label="Предыдущие направления">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="nav-arrow-btn" id="destinations-next" aria-label="Следующие направления">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Info Modal Popover -->
  <div class="info-modal-backdrop" id="destinations-modal" style="display: none;">
    <div class="info-modal-card">
      <button type="button" class="info-modal-close" id="destinations-modal-close" aria-label="Закрыть">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="info-modal-header">
        <h3 class="info-modal-title" id="destinations-modal-title">Мальдивы</h3>
      </div>
      <p class="info-modal-text" id="destinations-modal-text"></p>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('destinations-slider-track') as HTMLDivElement | null;
    const dotsContainer = document.getElementById('destinations-dots') as HTMLDivElement | null;
    const prevBtn = document.getElementById('destinations-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('destinations-next') as HTMLButtonElement | null;

    const modal = document.getElementById('destinations-modal') as HTMLDivElement | null;
    const modalTitle = document.getElementById('destinations-modal-title') as HTMLHeadingElement | null;
    const modalText = document.getElementById('destinations-modal-text') as HTMLParagraphElement | null;

    if (!track) return;

    const trackEl = track;
    const containerEl = trackEl.parentElement as HTMLElement;

    let count = parseInt(trackEl.getAttribute('data-count') || '1', 10);
    const sliderControls = document.querySelector('.slider-controls-footer') as HTMLElement | null;

    if (count <= 1) {
      if (sliderControls) sliderControls.style.display = 'none';
      return;
    }

    // Стартуем строго со среднего блока (с 1-й оригинальной карточки)
    let currentIndex = count;
    let isTransitioning = false;

    function renderDots() {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      for (let i = 0; i < count; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = `dot ${i === 0 ? 'active' : ''}`;
        dot.setAttribute('aria-label', `Перейти к направлению ${i + 1}`);
        dot.addEventListener('click', () => {
          const currentReal = ((currentIndex % count) + count) % count;
          const diff = i - currentReal;
          currentIndex += diff;
          moveSlider(true);
        });
        dotsContainer.appendChild(dot);
      }
    }

    function updatePagination() {
      if (!dotsContainer) return;
      const currentReal = ((currentIndex % count) + count) % count;
      const dots = dotsContainer.querySelectorAll('.dot');
      dots.forEach((dot, idx) => {
        if (idx === currentReal) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }

    // Ровно 5 карточек на десктопе, 3 на планшете, 2 на мобильных устройствах
    function getVisibleCount() {
      if (window.innerWidth <= 640) return 2;
      if (window.innerWidth <= 1024) return 3;
      return 5;
    }

    function getGap() {
      return window.innerWidth < 640 ? 12 : 20;
    }

    function updateCardWidth() {
      const containerWidth = containerEl.clientWidth;
      const visibleCount = getVisibleCount();
      const gap = getGap();
      
      const cardWidth = (containerWidth - (visibleCount - 1) * gap) / visibleCount;

      containerEl.style.setProperty('--card-width', `${cardWidth}px`);
      containerEl.style.setProperty('--gap-width', `${gap}px`);
      return cardWidth + gap;
    }

    function moveSlider(animate = true) {
      const step = updateCardWidth();
      if (animate) {
        trackEl.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)';
        isTransitioning = true;
      } else {
        trackEl.style.transition = 'none';
        isTransitioning = false;
      }
      const offset = -currentIndex * step;
      trackEl.style.transform = `translate3d(${offset}px, 0, 0)`;
      updatePagination();
    }

    function handleNext() {
      if (isTransitioning) return;
      currentIndex++;
      moveSlider(true);
    }

    function handlePrev() {
      if (isTransitioning) return;
      currentIndex--;
      moveSlider(true);
    }

    trackEl.addEventListener('transitionend', () => {
      isTransitioning = false;
      const step = updateCardWidth();
      if (currentIndex >= 2 * count) {
        currentIndex = currentIndex - count;
        trackEl.style.transition = 'none';
        trackEl.style.transform = `translate3d(${-currentIndex * step}px, 0, 0)`;
      } else if (currentIndex < count) {
        currentIndex = currentIndex + count;
        trackEl.style.transition = 'none';
        trackEl.style.transform = `translate3d(${-currentIndex * step}px, 0, 0)`;
      }
    });

    prevBtn?.addEventListener('click', handlePrev);
    nextBtn?.addEventListener('click', handleNext);

    // --- Драг мышью и тачем ---
    let startX = 0;
    let currentDragX = 0;
    let isDragging = false;
    let movedDistance = 0;

    trackEl.addEventListener('dragstart', (e) => e.preventDefault());

    function onPointerDown(e: MouseEvent | TouchEvent) {
      if (isTransitioning) return;
      isDragging = true;
      movedDistance = 0;
      startX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      currentDragX = startX;
      trackEl.style.transition = 'none';
    }

    function onPointerMove(e: MouseEvent | TouchEvent) {
      if (!isDragging) return;
      currentDragX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const deltaX = currentDragX - startX;
      movedDistance = Math.abs(deltaX);
      const step = updateCardWidth();
      const currentOffset = -currentIndex * step + deltaX;
      trackEl.style.transform = `translate3d(${currentOffset}px, 0, 0)`;
    }

    function onPointerUp() {
      if (!isDragging) return;
      isDragging = false;
      const deltaX = currentDragX - startX;
      if (deltaX < -40) {
        currentIndex++;
      } else if (deltaX > 40) {
        currentIndex--;
      }
      moveSlider(true);
    }

    containerEl.addEventListener('mousedown', onPointerDown);
    window.addEventListener('mousemove', onPointerMove);
    window.addEventListener('mouseup', onPointerUp);

    containerEl.addEventListener('touchstart', onPointerDown, { passive: true });
    containerEl.addEventListener('touchmove', onPointerMove, { passive: true });
    containerEl.addEventListener('touchend', onPointerUp);

    trackEl.addEventListener('click', (e) => {
      if (movedDistance > 5) {
        e.preventDefault();
        e.stopPropagation();
        movedDistance = 0;
      }
    }, true);

    // Инициализация при старте
    renderDots();
    updateCardWidth();
    moveSlider(false);

    window.addEventListener('resize', () => {
      updateCardWidth();
      moveSlider(false);
    });

    // --- Фоновая динамическая синхронизация из Google Таблицы ---
    const PUBLISHED_KEY =
      (typeof import.meta !== 'undefined' && import.meta.env && import.meta.env.PUBLIC_GOOGLE_PUBLISHED_KEY) ||
      '2PACX-1vQeRQ5VAaQfGuBuOl1AKIktnCubBKhDAcGlQD5-1PyqIJ8P5VR6HKjRxkYBQZrWzeHs1QD5XlA54GGl';
    const REGIONS_GID =
      (typeof import.meta !== 'undefined' && import.meta.env && import.meta.env.PUBLIC_GOOGLE_REGIONS_GID) ||
      '995502228';
    const dynamicRegionDesc: Record<string, string> = {};

    function parseSimpleCSV(text: string): string[][] {
      const rows: string[][] = [];
      let currentRow: string[] = [];
      let currentCell = '';
      let inQuotes = false;
      for (let i = 0; i < text.length; i++) {
        const char = text[i];
        const nextChar = text[i + 1];
        if (char === '"') {
          if (inQuotes && nextChar === '"') {
            currentCell += '"';
            i++;
          } else {
            inQuotes = !inQuotes;
          }
        } else if (char === ',' && !inQuotes) {
          currentRow.push(currentCell);
          currentCell = '';
        } else if ((char === '\r' || char === '\n') && !inQuotes) {
          if (char === '\r' && nextChar === '\n') i++;
          currentRow.push(currentCell);
          if (currentRow.some(c => c.trim() !== '')) rows.push(currentRow);
          currentRow = [];
          currentCell = '';
        } else {
          currentCell += char;
        }
      }
      if (currentCell || currentRow.length > 0) {
        currentRow.push(currentCell);
        if (currentRow.some(c => c.trim() !== '')) rows.push(currentRow);
      }
      return rows;
    }

    function cleanStr(s: string): string {
      return (s || '')
        .toLowerCase()
        .replace(/[\u{1F300}-\u{1F9FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E6}-\u{1F1FF}]+/gu, '')
        .replace(/[^a-zа-яё0-9]/gi, '')
        .trim();
    }

    function extractUrls(str: string): string[] {
      if (!str) return [];
      const rawMatches = str.match(/https?:\/\/[^\s\"]+/g) || [];
      const urls: string[] = [];
      for (const match of rawMatches) {
        const parts = match.split(/(?=https?:\/\/)/).map(u => u.trim()).filter(Boolean);
        for (let p of parts) {
          p = p.replace(/[,;]+$/, '');
          if (p) urls.push(p);
        }
      }
      return urls;
    }

    function formatGoogleDriveImageUrl(url: string): string {
      if (!url || typeof url !== 'string') return '';
      const trimmed = url.trim();
      if (!trimmed) return '';

      if (trimmed.includes('/folders/') || trimmed.includes('/drive/folders/')) {
        return trimmed;
      }

      const driveMatch = trimmed.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/) || 
                         trimmed.match(/drive\.google\.com\/thumbnail\?.*id=([a-zA-Z0-9_-]+)/) ||
                         trimmed.match(/lh3\.google\.com\/u\/\d+\/d\/([a-zA-Z0-9_-]+)/) ||
                         trimmed.match(/lh3\.googleusercontent\.com\/d\/([a-zA-Z0-9_-]+)/) ||
                         trimmed.match(/drive\.google\.com\/open\?id=([a-zA-Z0-9_-]+)/) ||
                         trimmed.match(/drive\.google\.com\/uc\?.*id=([a-zA-Z0-9_-]+)/) ||
                         trimmed.match(/docs\.google\.com\/uc\?.*id=([a-zA-Z0-9_-]+)/);

      if (driveMatch && driveMatch[1]) {
        const fileId = driveMatch[1].replace(/=w\d+/, '');
        if (trimmed.toLowerCase().endsWith('.svg') || trimmed.toLowerCase().includes('.svg')) {
          return `https://drive.google.com/uc?export=view&id=${fileId}`;
        }
        return `https://lh3.googleusercontent.com/d/${fileId}`;
      }

      return trimmed;
    }

    function bindCardEvents(card: HTMLElement) {
      const countryId = card.getAttribute('data-country-id') || '';
      const countryName = card.getAttribute('data-country-name') || '';
      const infoBtn = card.querySelector('[data-info-btn]');

      if (infoBtn) {
        infoBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (modal && modalTitle && modalText) {
            const cleanKey = cleanStr(countryName);
            const dynamicDesc = cleanKey ? dynamicRegionDesc[cleanKey] : null;
            const fallbackDesc = card.getAttribute('data-country-desc');
            const finalDesc = dynamicDesc || fallbackDesc || '';

            if (!finalDesc) return;

            modalTitle.textContent = countryName;
            modalText.textContent = finalDesc;
            modal.style.display = 'flex';
          }
        });
      }

      card.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('selectCountryFilter', { detail: { countryId } }));
        const yachtsElem = document.getElementById('yachts');
        if (yachtsElem) {
          yachtsElem.scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

    const CLIENT_FLAGS_MAP: Record<string, string> = {
      maldives: 'mv', indonesia: 'id', seychelles: 'sc', galapagos: 'ec', ecuador: 'ec',
      oman: 'om', palau: 'pw', egypt: 'eg', 'costa-rica': 'cr', costarica: 'cr',
      russia: 'ru', thailand: 'th', turkey: 'tr', greece: 'gr', italy: 'it', spain: 'es',
      croatia: 'hr', norway: 'no', france: 'fr', montenegro: 'me',
      мальдивы: 'mv', индонезия: 'id', сейшелы: 'sc', галапагосы: 'ec',
      оман: 'om', палау: 'pw', египет: 'eg', 'коста-рика': 'cr', костарика: 'cr',
      россия: 'ru', таиланд: 'th', тайланд: 'th', турция: 'tr', греция: 'gr',
      италия: 'it', испания: 'es', хорватия: 'hr', норвегия: 'no', франция: 'fr', черногория: 'me'
    };

    function createSingleCard(item: { name: string; id: string; desc: string; flagUrl?: string; bgUrl?: string }): HTMLElement {
      const card = document.createElement('div');
      card.className = 'compact-card';
      card.setAttribute('data-country-id', item.id);
      card.setAttribute('data-country-name', item.name);
      card.setAttribute('data-country-desc', item.desc);

      const hasDesc = Boolean(item.desc);
      const cleanKey = cleanStr(item.name) || cleanStr(item.id);
      const flagCode = CLIENT_FLAGS_MAP[cleanKey] || CLIENT_FLAGS_MAP[item.id.toLowerCase()] || CLIENT_FLAGS_MAP[item.name.toLowerCase()] || '';
      const flagUrl = item.flagUrl || (flagCode ? `https://flagcdn.com/${flagCode}.svg` : '');
      const bgUrl = item.bgUrl || flagUrl;

      card.innerHTML = `
        ${bgUrl ? `
          <div class="card-bg-img">
            <img src="${bgUrl}" alt="Фон ${item.name}" loading="lazy" />
          </div>
        ` : ''}
        <div class="card-top-row">
          <div class="compact-flag-wrap" title="Флаг: ${item.name}">
            ${flagUrl ? `<img src="${flagUrl}" alt="Флаг ${item.name}" class="compact-flag-img" loading="lazy" onerror="this.style.display='none'" />` : '<span class="compact-flag-emoji">🏝️</span>'}
          </div>
          <button
            type="button"
            class="compact-info-btn"
            title="Информация о направлении"
            aria-label="Информация о направлении ${item.name}"
            data-info-btn
            style="${hasDesc ? 'display: flex;' : 'display: none;'}"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </button>
        </div>
        <div class="card-bottom-content">
          <h3 class="compact-country-name">${item.name}</h3>
          <div class="compact-action-hint">
            <span>Смотреть яхты</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </div>
        </div>
      `;

      bindCardEvents(card);
      return card;
    }

    Promise.all([
      fetch(`https://docs.google.com/spreadsheets/d/e/${PUBLISHED_KEY}/pubhtml?t=${Date.now()}`)
        .then(r => r.ok ? r.text() : '').catch(() => ''),
      fetch(`https://docs.google.com/spreadsheets/d/e/${PUBLISHED_KEY}/pub?gid=${REGIONS_GID}&single=true&output=csv&t=${Date.now()}`)
        .then(r => r.ok ? r.text() : '').catch(() => '')
    ]).then(async ([pubHtml, csvText]) => {
      const detectedTabs: { name: string; gid: string }[] = [];

      if (pubHtml) {
        const regex = /name:\s*"([^"]+)",\s*pageUrl:\s*"[^"]*",\s*gid:\s*"([^"]+)"/g;
        let match;
        const ignore = ['регионы', 'regions', 'общаяинфаfaq', 'общаяинфа', 'faq', 'отзывыклиентов', 'отзывы', 'reviews'];
        while ((match = regex.exec(pubHtml)) !== null) {
          const rawName = match[1]
            .replace(/\\x26/g, '&').replace(/\\x27/g, "'").replace(/\\x22/g, '"')
            .replace(/\\u([0-9a-fA-F]{4})/g, (_, c) => String.fromCharCode(parseInt(c, 16)))
            .replace(/\\/g, '');
          const key = cleanStr(rawName);
          if (key && !ignore.includes(key)) {
            detectedTabs.push({ name: rawName.trim(), gid: match[2] });
          }
        }
      }

      if (csvText) {
        const rows = parseSimpleCSV(csvText);
        for (const row of rows) {
          const descCell = String(row[0] || '').trim();
          if (!descCell || descCell === 'Описание региона' || descCell.toLowerCase().startsWith('http')) continue;
          const lines = descCell.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
          if (lines.length === 0) continue;
          const cleanName = cleanStr(lines[0]);
          if (!cleanName || cleanName === 'название' || cleanName.length < 2) continue;
          const desc = lines.slice(1).join('\n').trim();
          if (desc) {
            dynamicRegionDesc[cleanName] = desc;
          }
        }
      }

      // Проверяем каждую вкладку на наличие реальных данных (яхт).
      // Если данных нет (вкладка пустая / только заголовок), карточка НЕ создается и удаляется!
      const tabDataPromises = detectedTabs.map(async (tab) => {
        try {
          const res = await fetch(`https://docs.google.com/spreadsheets/d/e/${PUBLISHED_KEY}/pub?gid=${tab.gid}&single=true&output=csv&t=${Date.now()}`);
          if (!res.ok) return null;
          const text = await res.text();
          const rows = parseSimpleCSV(text);
          let yachtCount = 0;
          let tabFlag = '';
          let tabMap = '';

          for (let i = 1; i < rows.length; i++) {
            const row = rows[i];
            const nameCell = String(row[0] || '').trim();
            if (nameCell && nameCell !== 'Яхта' && nameCell !== 'Название' && !nameCell.toLowerCase().startsWith('http')) {
              yachtCount++;
            }
            const flagCell = String(row[8] || '').trim();
            if (flagCell && !tabFlag) {
              const urls = extractUrls(flagCell);
              if (urls.length > 0) tabFlag = formatGoogleDriveImageUrl(urls[0]);
            }
            const mapCell = String(row[9] || '').trim();
            if (mapCell && !tabMap) {
              const urls = extractUrls(mapCell);
              if (urls.length > 0) tabMap = formatGoogleDriveImageUrl(urls[0]);
            }
          }

          // Если в таблице нет ни одной яхты - данных нет!
          if (yachtCount === 0) {
            return null;
          }

          return {
            tab,
            yachtCount,
            flagUrl: tabFlag,
            bgUrl: tabMap || tabFlag
          };
        } catch (e) {
          return null;
        }
      });

      const tabResults = await Promise.all(tabDataPromises);
      const validTabs = tabResults.filter((r): r is NonNullable<typeof r> => r !== null);
      const activeSheetKeys = new Set<string>(validTabs.map(r => cleanStr(r.tab.name)));
      const activeTabsList = validTabs.map(r => r.tab);

      if (validTabs.length > 0) {
        const existingDOMCards = Array.from(trackEl.querySelectorAll('.compact-card'));
        const uniqueDOMCountries = new Map<string, { name: string; id: string; desc: string; flagUrl?: string; bgUrl?: string; html?: HTMLElement }>();

        existingDOMCards.forEach((c) => {
          const name = c.getAttribute('data-country-name') || '';
          const id = c.getAttribute('data-country-id') || '';
          const desc = c.getAttribute('data-country-desc') || '';
          const key = cleanStr(name) || cleanStr(id);
          if (key && !uniqueDOMCountries.has(key)) {
            uniqueDOMCountries.set(key, { name, id, desc, html: c as HTMLElement });
          }
        });

        const finalList: { name: string; id: string; desc: string; flagUrl?: string; bgUrl?: string; html?: HTMLElement }[] = [];
        validTabs.forEach(({ tab, flagUrl, bgUrl }) => {
          const key = cleanStr(tab.name);
          const desc = dynamicRegionDesc[key] || '';
          if (uniqueDOMCountries.has(key)) {
            const existing = uniqueDOMCountries.get(key)!;
            finalList.push({
              ...existing,
              desc: desc || existing.desc,
              flagUrl: flagUrl || existing.flagUrl,
              bgUrl: bgUrl || existing.bgUrl
            });
          } else {
            finalList.push({
              name: tab.name,
              id: tab.name.toLowerCase(),
              desc,
              flagUrl,
              bgUrl
            });
          }
        });

        const isChanged = finalList.length !== count || finalList.some((item, i) => {
          const currentKey = cleanStr(existingDOMCards[i]?.getAttribute('data-country-name') || '');
          return currentKey !== cleanStr(item.name);
        });

        if (isChanged && finalList.length > 0) {
          trackEl.innerHTML = '';
          const trippled = finalList.length > 1 ? [...finalList, ...finalList, ...finalList] : finalList;

          trippled.forEach((item) => {
            if (item.html && !item.flagUrl && !item.bgUrl) {
              const clone = item.html.cloneNode(true) as HTMLElement;
              bindCardEvents(clone);
              trackEl.appendChild(clone);
            } else {
              const newCard = createSingleCard(item);
              trackEl.appendChild(newCard);
            }
          });

          count = finalList.length;
          currentIndex = count;

          if (count <= 1 && sliderControls) {
            sliderControls.style.display = 'none';
          } else if (sliderControls) {
            sliderControls.style.display = 'flex';
          }

          renderDots();
          updateCardWidth();
          moveSlider(false);
        }

        window.dispatchEvent(new CustomEvent('syncActiveCountries', {
          detail: { activeNames: Array.from(activeSheetKeys), activeTabs: activeTabsList }
        }));
      }

      trackEl.querySelectorAll('.compact-card').forEach((card) => {
        const cName = cleanStr(card.getAttribute('data-country-name') || '');
        const infoBtn = card.querySelector<HTMLElement>('[data-info-btn]');
        const hasDesc = Boolean(cName && dynamicRegionDesc[cName]);
        if (infoBtn) {
          infoBtn.style.display = hasDesc ? 'flex' : 'none';
        }
      });
    }).catch(() => {});

    trackEl.querySelectorAll<HTMLElement>('.compact-card').forEach(bindCardEvents);
  });
</script>

