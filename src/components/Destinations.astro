---
import type { Country } from '../lib/sheets';

interface Props {
  countries: Country[];
}

const { countries } = Astro.props;

const COUNTRY_FLAGS_MAP: Record<string, string> = {
  maldives: 'mv',
  indonesia: 'id',
  seychelles: 'sc',
  galapagos: 'ec',
  ecuador: 'ec',
  oman: 'om',
  palau: 'pw',
  egypt: 'eg',
  'costa-rica': 'cr',
  costarica: 'cr',
  russia: 'ru',
  thailand: 'th',
  turkey: 'tr',
  greece: 'gr',
  italy: 'it',
  spain: 'es',
  croatia: 'hr',
  norway: 'no',
  france: 'fr',
  montenegro: 'me',
  // Русские названия
  мальдивы: 'mv',
  индонезия: 'id',
  сейшелы: 'sc',
  галапагосы: 'ec',
  оман: 'om',
  палау: 'pw',
  египет: 'eg',
  'коста-рика': 'cr',
  костарика: 'cr',
  россия: 'ru',
  таиланд: 'th',
  тайланд: 'th',
  турция: 'tr',
  греция: 'gr',
  италия: 'it',
  испания: 'es',
  хорватия: 'hr',
  норвегия: 'no',
  франция: 'fr',
  черногория: 'me',
};

function emojiToCountryCode(emoji: string): string | null {
  if (!emoji) return null;
  const chars = [...emoji];
  if (chars.length >= 2) {
    const code1 = chars[0].codePointAt(0);
    const code2 = chars[1].codePointAt(0);
    if (code1 && code2 && code1 >= 0x1F1E6 && code1 <= 0x1F1FF && code2 >= 0x1F1E6 && code2 <= 0x1F1FF) {
      return (String.fromCharCode(code1 - 0x1F1E6 + 65) + String.fromCharCode(code2 - 0x1F1E6 + 65)).toLowerCase();
    }
  }
  return null;
}

function getCountryFlagUrl(country: Country): string {
  // 1. Если есть ссылка на флаг (из Google Таблицы / Google Drive / URL) - ВСЕГДА используем именно её!
  if (country.flag && (country.flag.startsWith('http://') || country.flag.startsWith('https://'))) {
    return country.flag;
  }
  // 2. Если есть emoji флага
  if (country.flag) {
    const emojiCode = emojiToCountryCode(country.flag);
    if (emojiCode) {
      return `https://flagcdn.com/${emojiCode}.svg`;
    }
  }
  // 3. Автоматически по названию страны
  const idKey = (country.id || '').toLowerCase().trim();
  const nameKey = (country.name || '').toLowerCase().trim();
  const code = COUNTRY_FLAGS_MAP[idKey] || COUNTRY_FLAGS_MAP[nameKey];
  if (code) {
    return `https://flagcdn.com/${code}.svg`;
  }
  return '';
}

function getCountryCardBgUrl(country: Country): string {
  // 1. Если есть прямая ссылка на карту (из Google Таблицы / Google Drive / URL)
  if (country.image && (country.image.startsWith('http://') || country.image.startsWith('https://'))) {
    return country.image;
  }
  return '';
}

// Тройное клонирование списка для бесшовной бесконечной прокрутки
const displayItems = countries.length > 1 ? [...countries, ...countries, ...countries] : [...countries];
const L = countries.length;
---

<section id="destinations" class="section destinations-section">
  <div class="container">
    <!-- Header -->
    <div class="destinations-header section-header">
      <div>
        <span class="title">НАПРАВЛЕНИЯ</span>
        <h2 class="section-title">Популярные направления</h2>
      </div>

      <button
        type="button"
        class="view-all-destinations-btn"
        id="open-all-destinations-btn"
        title="Смотреть все направления"
        aria-label="Смотреть все направления"
      >
        <span>Все направления</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>

    <div class="slider-wrapper">
      <div class="slider-track" id="destinations-slider-track" data-length={L} data-count={countries.length}>
        {displayItems.map((country: Country) => {
          const flagUrl = getCountryFlagUrl(country);
          const bgUrl = getCountryCardBgUrl(country);
          return (
            <div
              class="compact-card"
              data-country-id={country.id}
              data-country-name={country.name}
              data-country-desc={country.description}
            >
              {bgUrl && (
                <div class="card-bg-img">
                  <img
                    src={bgUrl}
                    alt={`Карта ${country.name}`}
                    loading="lazy"
                    referrerpolicy="no-referrer"
                    draggable="false"
                  />
                </div>
              )}

              <!-- Top Row: Flag on left + Info button on right -->
              <div class="card-top-row">
                <div class="compact-flag-wrap" title={`Флаг: ${country.name}`}>
                  {flagUrl ? (
                    <img
                      src={flagUrl}
                      alt={`Флаг ${country.name}`}
                      class="compact-flag-img"
                      loading="lazy"
                      referrerpolicy="no-referrer"
                      onerror={`this.onerror=null; const code='${COUNTRY_FLAGS_MAP[(country.id || '').toLowerCase()] || COUNTRY_FLAGS_MAP[(country.name || '').toLowerCase()] || ''}'; if(code){ this.src='https://flagcdn.com/'+code+'.svg'; } else { this.style.display='none'; }`}
                    />
                  ) : (
                    <span class="compact-flag-emoji">{country.flag || '🏝️'}</span>
                  )}
                </div>

                <button
                  type="button"
                  class="compact-info-btn"
                  title="Информация о направлении"
                  aria-label={`Информация о направлении ${country.name}`}
                  data-info-btn
                  style={country.description ? 'display: flex;' : 'display: none;'}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                  </svg>
                </button>
              </div>

              <!-- Bottom Content: Country Name on top + "Смотреть яхты ->" underneath -->
              <div class="card-bottom-content">
                <h3 class="compact-country-name">{country.name}</h3>
                <div class="compact-action-hint">
                  <span>Смотреть яхты</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <script is:inline>
        (function() {
          try {
            var cachedTabs = localStorage.getItem('yacht_active_tabs_cache');
            if (cachedTabs) {
              var payload = JSON.parse(cachedTabs);
              if (payload && payload.activeNames && payload.activeNames.length > 0) {
                var allowed = {};
                payload.activeNames.forEach(function(n) {
                  var clean = (n || '').toLowerCase().replace(/[\u{1F300}-\u{1F9FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E6}-\u{1F1FF}]+/gu, '').replace(/[^a-zа-яё0-9]/gi, '').trim();
                  allowed[n.toLowerCase().trim()] = true;
                  allowed[clean] = true;
                });
                var track = document.getElementById('destinations-slider-track');
                if (track) {
                  var cards = track.querySelectorAll('.compact-card');
                  cards.forEach(function(card) {
                    var cId = (card.getAttribute('data-country-id') || '').toLowerCase().trim();
                    var cName = (card.getAttribute('data-country-name') || '').toLowerCase().trim();
                    var cleanCName = (cName || '').replace(/[^a-zа-яё0-9]/gi, '').trim();
                    var cleanCId = (cId || '').replace(/[^a-zа-яё0-9]/gi, '').trim();
                    if (!allowed[cId] && !allowed[cName] && !allowed[cleanCName] && !allowed[cleanCId]) {
                      card.remove();
                    }
                  });
                }
              }
            }
          } catch(e) {}
        })();
      </script>
    </div>

    <div class="slider-controls-footer" id="destinations-slider-controls">
      <div class="pagination-dots" id="destinations-dots">
      </div>

      <div class="nav-arrows">
        <button type="button" class="nav-arrow-btn" id="destinations-prev" aria-label="Предыдущие направления">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button type="button" class="nav-arrow-btn" id="destinations-next" aria-label="Следующие направления">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Info Modal Popover -->
  <div class="info-modal-backdrop" id="destinations-modal" style="display: none;">
    <div class="info-modal-card">
      <button type="button" class="info-modal-close" id="destinations-modal-close" aria-label="Закрыть">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="info-modal-header">
        <h3 class="info-modal-title" id="destinations-modal-title">Мальдивы</h3>
      </div>
      <p class="info-modal-text" id="destinations-modal-text"></p>
    </div>
  </div>

  <!-- All Destinations Modal (Вариант 1) -->
  <div class="all-destinations-modal-backdrop" id="all-destinations-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="all-destinations-title">
    <div class="all-destinations-modal-card">
      <!-- Modal Header -->
      <div class="all-destinations-header">
        <div class="all-destinations-title-wrap">
          <h3 class="all-destinations-title" id="all-destinations-title">Все направления</h3>
          <span class="all-destinations-count-pill" id="all-destinations-count-pill">{countries.length} стран</span>
        </div>
        <button type="button" class="all-destinations-close" id="all-destinations-close" aria-label="Закрыть модальное окно">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Search Bar -->
      <div class="all-destinations-search-wrap">
        <div class="search-input-box">
          <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="all-destinations-search-input"
            class="all-destinations-search-input"
            placeholder="Поиск страны или региона (Мальдивы, Сейшелы, Турция...)"
            autocomplete="off"
          />
          <button type="button" id="all-destinations-search-clear" class="search-clear-btn" style="display: none;" aria-label="Очистить поиск">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Destinations Grid -->
      <div class="all-destinations-body">
        <div class="all-destinations-grid" id="all-destinations-grid">
          {countries.map((country: Country) => {
            const flagUrl = getCountryFlagUrl(country);
            const bgUrl = getCountryCardBgUrl(country);
            return (
              <div
                class="all-dest-card"
                data-country-id={country.id}
                data-country-name={country.name}
                data-country-desc={country.description}
                role="button"
                tabindex="0"
              >
                {bgUrl && (
                  <div class="all-dest-card-bg">
                    <img
                      src={bgUrl}
                      alt={`Карта ${country.name}`}
                      loading="lazy"
                      referrerpolicy="no-referrer"
                      onerror="this.parentElement.style.display='none'"
                    />
                  </div>
                )}
                <div class="all-dest-card-top">
                  <div class="all-dest-flag-wrap" title={`Флаг: ${country.name}`}>
                    {flagUrl ? (
                      <img
                        src={flagUrl}
                        alt={`Флаг ${country.name}`}
                        class="all-dest-flag-img"
                        loading="lazy"
                        onerror={`this.onerror=null; const code='${COUNTRY_FLAGS_MAP[(country.id || '').toLowerCase()] || COUNTRY_FLAGS_MAP[(country.name || '').toLowerCase()] || ''}'; if(code){ this.src='https://flagcdn.com/'+code+'.svg'; } else { this.style.display='none'; }`}
                      />
                    ) : (
                      <span class="all-dest-flag-emoji">{country.flag || '🏝️'}</span>
                    )}
                  </div>
                  <button
                    type="button"
                    class="compact-info-btn all-dest-info-btn"
                    title="Информация о направлении"
                    aria-label={`Информация о направлении ${country.name}`}
                    data-info-btn
                    style={country.description ? 'display: flex;' : 'display: none;'}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <line x1="12" y1="16" x2="12" y2="12"></line>
                      <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                  </button>
                </div>

                <div class="all-dest-card-content">
                  <h4 class="all-dest-card-name">{country.name}</h4>
                  <span class="all-dest-action-link">
                    <span>Смотреть яхты</span>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </div>
              </div>
            );
          })}
        </div>

        <!-- No search results -->
        <div class="all-dest-empty-state" id="all-dest-empty" style="display: none;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <p>Ничего не найдено по вашему запросу</p>
          <button type="button" class="all-dest-reset-search" id="all-dest-reset-btn">
            Показать все страны
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Shared state and lookup tables
    const dynamicRegionDesc: Record<string, string> = {};

    function cleanStr(s: string): string {
      return (s || '')
        .toLowerCase()
        .replace(/[\u{1F300}-\u{1F9FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E6}-\u{1F1FF}]+/gu, '')
        .replace(/[^a-zа-яё0-9]/gi, '')
        .trim();
    }

    function transliterate(text: string): string {
      const map: Record<string, string> = {
        'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd', 'е': 'e', 'ё': 'yo', 'ж': 'zh',
        'з': 'z', 'и': 'i', 'й': 'y', 'к': 'k', 'л': 'l', 'м': 'm', 'н': 'n', 'о': 'o',
        'п': 'p', 'р': 'r', 'с': 's', 'т': 't', 'у': 'u', 'ф': 'f', 'х': 'kh', 'ц': 'ts',
        'ч': 'ch', 'ш': 'sh', 'щ': 'shch', 'ъ': '', 'ы': 'y', 'ь': '', 'э': 'e', 'ю': 'yu', 'я': 'ya'
      };
      return text.toLowerCase().split('').map(char => map[char] || char).join('').replace(/[^a-z0-9]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
    }

    function getCountriesCountText(n: number): string {
      const mod10 = n % 10;
      const mod100 = n % 100;
      if (mod100 >= 11 && mod100 <= 19) return `${n} стран`;
      if (mod10 === 1) return `${n} страна`;
      if (mod10 >= 2 && mod10 <= 4) return `${n} страны`;
      return `${n} стран`;
    }

    const CLIENT_FLAGS_MAP: Record<string, string> = {
      maldives: 'mv', indonesia: 'id', seychelles: 'sc', galapagos: 'ec', ecuador: 'ec',
      oman: 'om', palau: 'pw', egypt: 'eg', 'costa-rica': 'cr', costarica: 'cr',
      russia: 'ru', thailand: 'th', turkey: 'tr', greece: 'gr', italy: 'it', spain: 'es',
      croatia: 'hr', norway: 'no', france: 'fr', montenegro: 'me',
      мальдивы: 'mv', индонезия: 'id', сейшелы: 'sc', галапагосы: 'ec',
      оман: 'om', палау: 'pw', египет: 'eg', 'коста-рика': 'cr', костарика: 'cr',
      россия: 'ru', таиланд: 'th', тайланд: 'th', турция: 'tr', греция: 'gr',
      италия: 'it', испания: 'es', хорватия: 'hr', норвегия: 'no', франция: 'fr', черногория: 'me'
    };

    // --- Info Modal Popover ---
    const modal = document.getElementById('destinations-modal') as HTMLDivElement | null;
    const modalClose = document.getElementById('destinations-modal-close') as HTMLButtonElement | null;
    const modalTitle = document.getElementById('destinations-modal-title') as HTMLHeadingElement | null;
    const modalText = document.getElementById('destinations-modal-text') as HTMLParagraphElement | null;

    function openDestinationsModal(title: string, desc: string) {
      if (!modal || !modalTitle || !modalText) return;
      modalTitle.textContent = title;
      modalText.textContent = desc;
      modalText.scrollTop = 0;
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }

    function closeDestinationsModal() {
      if (modal) {
        modal.style.display = 'none';
      }
      if (!allModal || allModal.style.display === 'none') {
        document.body.style.overflow = '';
      }
    }

    modalClose?.addEventListener('click', closeDestinationsModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeDestinationsModal();
      }
    });

    // --- All Destinations Modal (Вариант 1) with Real-Time Search ---
    const allModal = document.getElementById('all-destinations-modal') as HTMLDivElement | null;
    const openAllBtn = document.getElementById('open-all-destinations-btn') as HTMLButtonElement | null;
    const allCloseBtn = document.getElementById('all-destinations-close') as HTMLButtonElement | null;
    const searchInput = document.getElementById('all-destinations-search-input') as HTMLInputElement | null;
    const searchClearBtn = document.getElementById('all-destinations-search-clear') as HTMLButtonElement | null;
    const allGrid = document.getElementById('all-destinations-grid') as HTMLDivElement | null;
    const allEmptyState = document.getElementById('all-dest-empty') as HTMLDivElement | null;
    const allResetBtn = document.getElementById('all-dest-reset-btn') as HTMLButtonElement | null;
    const countPill = document.getElementById('all-destinations-count-pill') as HTMLSpanElement | null;

    function openAllDestinationsModal() {
      if (!allModal) return;
      allModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      if (searchInput) {
        searchInput.value = '';
        performFilter('');
        setTimeout(() => searchInput.focus(), 80);
      }
    }

    function closeAllDestinationsModal() {
      if (!allModal) return;
      allModal.style.display = 'none';
      document.body.style.overflow = '';
    }

    // Single unified Escape handler with correct stacking order
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (modal && modal.style.display !== 'none') {
          closeDestinationsModal();
          return;
        }
        if (allModal && allModal.style.display !== 'none') {
          closeAllDestinationsModal();
        }
      }
    });

    function performFilter(rawQuery: string) {
      const q = rawQuery.trim().toLowerCase();
      if (searchClearBtn) {
        searchClearBtn.style.display = q ? 'flex' : 'none';
      }

      const cards = allGrid?.querySelectorAll<HTMLElement>('.all-dest-card') || [];
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = (card.getAttribute('data-country-name') || '').toLowerCase();
        const id = (card.getAttribute('data-country-id') || '').toLowerCase();
        const trans = transliterate(name);
        const matches = !q || name.includes(q) || id.includes(q) || trans.includes(q);

        if (matches) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (allEmptyState) {
        allEmptyState.style.display = visibleCount === 0 ? 'flex' : 'none';
      }
    }

    function bindAllDestCard(card: HTMLElement) {
      const countryId = card.getAttribute('data-country-id') || '';
      const countryName = card.getAttribute('data-country-name') || '';
      const infoBtn = card.querySelector<HTMLElement>('[data-info-btn]');

      if (infoBtn) {
        infoBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const cleanKey = cleanStr(countryName);
          const dynamicDesc = cleanKey ? dynamicRegionDesc[cleanKey] : null;
          const fallbackDesc = card.getAttribute('data-country-desc');
          const finalDesc = dynamicDesc || fallbackDesc || '';

          if (!finalDesc) return;
          openDestinationsModal(countryName, finalDesc);
        });
      }

      const handleSelect = () => {
        closeAllDestinationsModal();
        window.dispatchEvent(new CustomEvent('selectCountryFilter', { detail: { countryId } }));
        const yachtsElem = document.getElementById('yachts');
        if (yachtsElem) {
          yachtsElem.scrollIntoView({ behavior: 'smooth' });
        }
      };

      card.addEventListener('click', handleSelect);
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleSelect();
        }
      });
    }

    openAllBtn?.addEventListener('click', openAllDestinationsModal);
    allCloseBtn?.addEventListener('click', closeAllDestinationsModal);
    allModal?.addEventListener('click', (e) => {
      if (e.target === allModal) {
        closeAllDestinationsModal();
      }
    });

    searchInput?.addEventListener('input', () => {
      performFilter(searchInput.value);
    });

    searchClearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
        performFilter('');
      }
    });

    allResetBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
        performFilter('');
      }
    });

    // Bind SSR-rendered cards in the modal
    allGrid?.querySelectorAll<HTMLElement>('.all-dest-card').forEach(bindAllDestCard);

    function createModalDestCard(item: { name: string; id: string; desc: string; flagUrl?: string; bgUrl?: string }): HTMLElement {
      const card = document.createElement('div');
      card.className = 'all-dest-card';
      card.setAttribute('data-country-id', item.id);
      card.setAttribute('data-country-name', item.name);
      card.setAttribute('data-country-desc', item.desc);
      card.setAttribute('role', 'button');
      card.setAttribute('tabindex', '0');

      const hasDesc = Boolean(item.desc);
      const cleanKey = cleanStr(item.name) || cleanStr(item.id);
      const flagCode = CLIENT_FLAGS_MAP[cleanKey] || CLIENT_FLAGS_MAP[item.id.toLowerCase()] || CLIENT_FLAGS_MAP[item.name.toLowerCase()] || '';
      const flagUrl = item.flagUrl || (flagCode ? `https://flagcdn.com/${flagCode}.svg` : '');
      const bgUrl = item.bgUrl || '';

      card.innerHTML = `
        ${bgUrl ? `
          <div class="all-dest-card-bg">
            <img
              src="${bgUrl}"
              alt="Карта ${item.name}"
              loading="lazy"
              referrerpolicy="no-referrer"
              onerror="this.parentElement.style.display='none'"
            />
          </div>
        ` : ''}
        <div class="all-dest-card-top">
          <div class="all-dest-flag-wrap" title="Флаг: ${item.name}">
            ${flagUrl ? `<img src="${flagUrl}" alt="Флаг ${item.name}" class="all-dest-flag-img" loading="lazy" onerror="this.style.display='none'" />` : '<span class="all-dest-flag-emoji">🏝️</span>'}
          </div>
          <button
            type="button"
            class="compact-info-btn all-dest-info-btn"
            title="Информация о направлении"
            aria-label="Информация о направлении ${item.name}"
            data-info-btn
            style="${hasDesc ? 'display: flex;' : 'display: none;'}"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </button>
        </div>
        <div class="all-dest-card-content">
          <h4 class="all-dest-card-name">${item.name}</h4>
          <span class="all-dest-action-link">
            <span>Смотреть яхты</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
