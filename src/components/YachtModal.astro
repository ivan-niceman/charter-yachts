</style>

<script>
  function setupModalSlider(modal: HTMLElement) {
    const container = modal.querySelector('.yacht-slider-container') as HTMLElement | null;
    const trackEl = modal.querySelector('.yacht-slider-track') as HTMLElement | null;
    if (!container || !trackEl) return null;

    const track = trackEl;
    const L = parseInt(track.getAttribute('data-length') || '1', 10);
    const count = parseInt(track.getAttribute('data-count') || '1', 10);

    if (count <= 1) {
      track.style.transform = 'none';
      return {
        reset: () => {},
        next: () => {},
        prev: () => {},
        goTo: (_i: number) => {},
        stopAutoplay: () => {},
        toggleAutoplay: () => {}
      };
    }

    let currentIndex = L;
    let isTransitioning = false;
    let autoplayTimer: number | null = null;

    function getSlideWidth() {
      return container ? container.clientWidth : 0;
    }

    function scrollThumbContainer(targetThumb: HTMLElement) {
      const thumbsContainer = modal.querySelector('.modal-thumbnails') as HTMLElement;
      if (!thumbsContainer || !targetThumb) return;
      const targetLeft = targetThumb.offsetLeft - (thumbsContainer.clientWidth / 2) + (targetThumb.clientWidth / 2);
      thumbsContainer.scrollTo({ left: targetLeft, behavior: 'smooth' });
    }

    function updateUI() {
      const realIdx = ((currentIndex % count) + count) % count;
      const currIdxLabel = modal.querySelector('.curr-idx');
      if (currIdxLabel) currIdxLabel.textContent = String(realIdx + 1);

      const thumbs = modal.querySelectorAll('.thumb-btn');
      thumbs.forEach((thumb, idx) => {
        if (idx === realIdx) {
          thumb.classList.add('active');
          scrollThumbContainer(thumb as HTMLElement);
        } else {
          thumb.classList.remove('active');
        }
      });
    }

    function moveSlider(animate = true) {
      if (animate) {
        track.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)';
        isTransitioning = true;
      } else {
        track.style.transition = 'none';
        isTransitioning = false;
      }
      track.style.transform = `translate3d(${-currentIndex * 100}%, 0, 0)`;
      updateUI();
    }

    function handleNext() {
      if (isTransitioning) return;
      currentIndex++;
      moveSlider(true);
    }

    function handlePrev() {
      if (isTransitioning) return;
      currentIndex--;
      moveSlider(true);
    }

    function goToRealIndex(targetRealIdx: number) {
      if (isTransitioning) return;
      const currentRealIdx = ((currentIndex % count) + count) % count;
      const diff = targetRealIdx - currentRealIdx;
      currentIndex += diff;
      moveSlider(true);
    }

    track.addEventListener('transitionend', () => {
      isTransitioning = false;
      if (currentIndex >= 2 * L) {
        currentIndex = currentIndex - L;
        track.style.transition = 'none';
        track.style.transform = `translate3d(${-currentIndex * 100}%, 0, 0)`;
      } else if (currentIndex < L) {
        currentIndex = currentIndex + L;
        track.style.transition = 'none';
        track.style.transform = `translate3d(${-currentIndex * 100}%, 0, 0)`;
      }
    });

    // Autoplay
    function stopAutoplay() {
      if (autoplayTimer !== null) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
      const btn = modal.querySelector('[data-autoplay-btn]') as HTMLElement;
      if (btn) {
        btn.classList.remove('is-playing');
        btn.setAttribute('title', 'Запустить автопрокрутку');
      }
    }

    function startAutoplay() {
      stopAutoplay();
      const btn = modal.querySelector('[data-autoplay-btn]') as HTMLElement;
      if (btn) {
        btn.classList.add('is-playing');
        btn.setAttribute('title', 'Остановить автопрокрутку');
      }
      autoplayTimer = window.setInterval(() => {
        handleNext();
      }, 3200);
    }

    function toggleAutoplay() {
      if (autoplayTimer !== null) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    }

    // Touch & Mouse Dragging
    let startX = 0;
    let currentDragX = 0;
    let isDragging = false;

    function onPointerDown(e: MouseEvent | TouchEvent) {
      if (isTransitioning) return;
      const target = e.target as HTMLElement;
      if (target.closest('.slider-nav') || target.closest('.slide-counter') || target.closest('[data-autoplay-btn]')) return;

      isDragging = true;
      startX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      currentDragX = startX;
      track.style.transition = 'none';
    }

    function onPointerMove(e: MouseEvent | TouchEvent) {
      if (!isDragging) return;
      currentDragX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const deltaX = currentDragX - startX;
      const slideW = getSlideWidth() || 1;
      const deltaPercent = (deltaX / slideW) * 100;
      const currentOffset = -currentIndex * 100 + deltaPercent;
      track.style.transform = `translate3d(${currentOffset}%, 0, 0)`;
    }

    function onPointerUp() {
      if (!isDragging) return;
      isDragging = false;
      const deltaX = currentDragX - startX;
      if (deltaX < -40) {
        currentIndex++;
      } else if (deltaX > 40) {
        currentIndex--;
      }
      moveSlider(true);
    }

    container.addEventListener('mousedown', onPointerDown);
    window.addEventListener('mousemove', onPointerMove);
    window.addEventListener('mouseup', onPointerUp);

    container.addEventListener('touchstart', onPointerDown, { passive: true });
    container.addEventListener('touchmove', onPointerMove, { passive: true });
    container.addEventListener('touchend', onPointerUp);

    // Initial positioning
    currentIndex = L;
    moveSlider(false);

    window.addEventListener('resize', () => {
      moveSlider(false);
    });

    return {
      reset: () => {
        stopAutoplay();
        currentIndex = L;
        moveSlider(false);
      },
      next: handleNext,
      prev: handlePrev,
      goTo: goToRealIndex,
      stopAutoplay,
      toggleAutoplay
    };
  }

  function initYachtModals() {
    const slidersMap = new Map<HTMLElement, ReturnType<typeof setupModalSlider>>();

    // Initialize all modals on page
    const modals = document.querySelectorAll('.modal-overlay');
    modals.forEach((m) => {
      const modal = m as HTMLElement;
      const slider = setupModalSlider(modal);
      if (slider) slidersMap.set(modal, slider);
    });

    function closeModal(modal: HTMLElement) {
      const slider = slidersMap.get(modal);
      if (slider) slider.stopAutoplay();

      modal.style.display = 'none';
      modal.classList.remove('is-active');

      const openCards = modal.querySelectorAll('.accordion-card.is-open');
      openCards.forEach((openCard) => {
        openCard.classList.remove('is-open');
        const openWrapper = openCard.querySelector('.accordion-body-wrapper') as HTMLElement;
        if (openWrapper) openWrapper.style.maxHeight = '0px';
        const openArrow = openCard.querySelector('.acc-arrow');
        if (openArrow) openArrow.classList.remove('rotated');
      });

      if (!document.querySelector('.modal-overlay.is-active')) {
        document.body.style.overflow = '';
      }
    }

    // Open modal event listener
    window.addEventListener('openYachtDetails', (e: any) => {
      const yachtId = e.detail?.yachtId;
      if (!yachtId) return;

      const modal = document.getElementById(`yacht-modal-${yachtId}`) as HTMLElement;
      if (modal) {
        modal.style.display = 'flex';
        modal.classList.add('is-active');
        document.body.style.overflow = 'hidden';

        const slider = slidersMap.get(modal);
        if (slider) {
          slider.reset();
        }
      }
    });

    // Global click delegate
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // Autoplay button
      const autoplayBtn = target.closest('[data-autoplay-btn]');
      if (autoplayBtn) {
        const modal = autoplayBtn.closest('.modal-overlay') as HTMLElement;
        if (modal) {
          const slider = slidersMap.get(modal);
          if (slider) slider.toggleAutoplay();
        }
        return;
      }

      // 1. Close button click
      const closeBtn = target.closest('[data-close-modal]');
      if (closeBtn) {
        const modal = closeBtn.closest('.modal-overlay') as HTMLElement;
        if (modal) closeModal(modal);
        return;
      }

      // 2. Click outside container to close
      const overlay = target.closest('.modal-overlay');
      const container = target.closest('.modal-container');
      if (overlay && !container) {
        closeModal(overlay as HTMLElement);
        return;
      }

      // 3. Thumb button click to change slide
      const thumbBtn = target.closest('.thumb-btn');
      if (thumbBtn) {
        const modal = thumbBtn.closest('.modal-overlay') as HTMLElement;
        const indexStr = thumbBtn.getAttribute('data-index');
        if (modal && indexStr !== null) {
          const idx = parseInt(indexStr, 10);
          const slider = slidersMap.get(modal);
          if (slider) slider.goTo(idx);
        }
        return;
      }

      // 4. Booking button within details modal
      const bookBtn = target.closest('[data-book-yacht]');
      if (bookBtn && bookBtn.closest('.modal-overlay')) {
        const yachtName = bookBtn.getAttribute('data-book-yacht');
        const modal = bookBtn.closest('.modal-overlay') as HTMLElement;
        if (yachtName) {
          if (modal) closeModal(modal);

          window.dispatchEvent(new CustomEvent('openBooking', {
            detail: { yachtName }
          }));
        }
        return;
      }

      // 5. Navigation prev / next arrows
      const prevBtn = target.closest('.nav-prev');
      const nextBtn = target.closest('.nav-next');
      if (prevBtn || nextBtn) {
        const modal = (prevBtn || nextBtn)!.closest('.modal-overlay') as HTMLElement;
        if (!modal) return;
        const slider = slidersMap.get(modal);
        if (slider) {
          if (prevBtn) slider.prev();
          else slider.next();
        }
        return;
      }

      // 6. Accordion collapse / expand toggle
      const accHeader = target.closest('.accordion-header');
      if (accHeader) {
        const card = accHeader.closest('.accordion-card');
        const wrapper = card?.querySelector('.accordion-body-wrapper') as HTMLElement;
        const arrow = accHeader.querySelector('.acc-arrow');
        if (card && wrapper) {
          const isOpen = card.classList.contains('is-open');
          if (isOpen) {
            card.classList.remove('is-open');
            wrapper.style.maxHeight = '0px';
            if (arrow) arrow.classList.remove('rotated');
          } else {
            const modal = card.closest('.modal-overlay');
            if (modal) {
              const openCards = modal.querySelectorAll('.accordion-card.is-open');
              openCards.forEach((openCard) => {
                if (openCard !== card) {
                  openCard.classList.remove('is-open');
                  const openWrapper = openCard.querySelector('.accordion-body-wrapper') as HTMLElement;
                  if (openWrapper) openWrapper.style.maxHeight = '0px';
                  const openArrow = openCard.querySelector('.acc-arrow');
                  if (openArrow) openArrow.classList.remove('rotated');
                }
              });
            }

            card.classList.add('is-open');
            const inner = wrapper.querySelector('.accordion-body-inner') as HTMLElement;
            wrapper.style.maxHeight = inner ? `${inner.scrollHeight}px` : '1200px';
            if (arrow) arrow.classList.add('rotated');
          }
        }
        return;
      }
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      const activeModal = document.querySelector('.modal-overlay.is-active') as HTMLElement;
      if (!activeModal) return;

      const activeEl = document.activeElement as HTMLElement;
      const isTyping = activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.isContentEditable);

      if (e.key === 'Escape') {
        closeModal(activeModal);
      } else if (e.key === 'ArrowLeft' && !isTyping) {
        const slider = slidersMap.get(activeModal);
        if (slider) slider.prev();
      } else if (e.key === 'ArrowRight' && !isTyping) {
        const slider = slidersMap.get(activeModal);
        if (slider) slider.next();
      }
    });

    // Image fallback recovery
    document.addEventListener('error', (e) => {
      const target = e.target as HTMLImageElement;
      if (!target || target.tagName !== 'IMG') return;

      const currentSrc = target.src || '';

      if (currentSrc.includes('lh3.googleusercontent.com/d/')) {
        const fileId = currentSrc.split('lh3.googleusercontent.com/d/')[1]?.split('=')[0];
        if (fileId) {
          target.src = `https://drive.google.com/thumbnail?id=${fileId}&sz=w1200`;
          return;
        }
      }
      if (currentSrc.includes('drive.google.com/thumbnail')) {
        const match = currentSrc.match(/id=([a-zA-Z0-9_-]+)/);
        if (match && match[1]) {
          target.src = `https://drive.google.com/uc?export=view&id=${match[1]}`;
          return;
        }
      }

      if (target.classList.contains('modal-main-image')) {
        const fallbacksAttr = target.getAttribute('data-fallback-images');
        if (fallbacksAttr) {
          try {
            const fallbacks = JSON.parse(fallbacksAttr);
            target.src = fallbacks[0];
          } catch (err) {
            target.src = 'https://images.unsplash.com/photo-1569263979104-865ab7cd8d13?auto=format&fit=crop&w=1200&q=80';
          }
        }
      }
    }, true);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initYachtModals);
  } else {
    initYachtModals();
  }
</script>
