</style>

<script>
  function setupModalSlider(modal: HTMLElement) {
    const container = modal.querySelector('.yacht-slider-container') as HTMLElement | null;
    const trackEl = modal.querySelector('.yacht-slider-track') as HTMLElement | null;
    if (!container || !trackEl) return null;

    const track = trackEl;
    let L = parseInt(track.getAttribute('data-length') || '1', 10);
    let count = parseInt(track.getAttribute('data-count') || '1', 10);

    let currentIndex = L;
    let isTransitioning = false;
    let autoplayTimer: number | null = null;

    function getSlideWidth() {
      return container ? container.clientWidth : 0;
    }

    function scrollThumbContainer(targetThumb: HTMLElement) {
      const thumbsContainer = modal.querySelector('.modal-thumbnails') as HTMLElement;
      if (!thumbsContainer || !targetThumb) return;
      const targetLeft = targetThumb.offsetLeft - (thumbsContainer.clientWidth / 2) + (targetThumb.clientWidth / 2);
      thumbsContainer.scrollTo({ left: targetLeft, behavior: 'smooth' });
    }

    function updateUI() {
      if (count <= 1) return;
      const realIdx = ((currentIndex % count) + count) % count;
      const currIdxLabel = modal.querySelector('.curr-idx');
      if (currIdxLabel) currIdxLabel.textContent = String(realIdx + 1);

      const thumbs = modal.querySelectorAll('.thumb-btn');
      thumbs.forEach((thumb, idx) => {
        if (idx === realIdx) {
          thumb.classList.add('active');
          scrollThumbContainer(thumb as HTMLElement);
        } else {
          thumb.classList.remove('active');
        }
      });
    }

    function pauseAllMedia(scope: HTMLElement) {
      const videos = scope.querySelectorAll('video');
      videos.forEach((v) => {
        try {
          if (!v.paused) v.pause();
        } catch (err) {}
      });

      const iframes = scope.querySelectorAll('iframe');
      iframes.forEach((iframe) => {
        try {
          iframe.contentWindow?.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
        } catch (err) {}
      });
    }

    const TRANSITION_MS = 250;
    let transitionTimer: number | null = null;
    let lastNavTime = 0;

    function preloadAdjacentMedia() {
      if (count <= 1) return;
      const slides = track.querySelectorAll('.yacht-slide');
      // Preload current, previous, and next 2 slides
      const offsets = [0, 1, -1, 2];
      offsets.forEach((offset) => {
        const targetIdx = currentIndex + offset;
        if (targetIdx >= 0 && targetIdx < slides.length) {
          const img = slides[targetIdx].querySelector('img.modal-main-image') as HTMLImageElement | null;
          if (img && img.src) {
            img.loading = 'eager';
            if (!img.complete) {
              const preloader = new Image();
              preloader.referrerPolicy = 'no-referrer';
              preloader.src = img.src;
            }
          }
        }
      });
    }

    function checkLoopReset() {
      if (count <= 1) return;
      if (currentIndex >= 2 * L) {
        currentIndex = currentIndex - L;
        track.style.transition = 'none';
        track.style.transform = `translate3d(${-currentIndex * 100}%, 0, 0)`;
      } else if (currentIndex < L) {
        currentIndex = currentIndex + L;
        track.style.transition = 'none';
        track.style.transform = `translate3d(${-currentIndex * 100}%, 0, 0)`;
      }
    }

    function finishTransition() {
      if (transitionTimer !== null) {
        clearTimeout(transitionTimer);
        transitionTimer = null;
      }
      isTransitioning = false;
      checkLoopReset();
    }

    function moveSlider(animate = true) {
      pauseAllMedia(modal);
      if (transitionTimer !== null) {
        clearTimeout(transitionTimer);
        transitionTimer = null;
      }

      if (count <= 1) {
        track.style.transition = 'none';
        track.style.transform = 'none';
        isTransitioning = false;
        return;
      }

      if (animate) {
        track.style.transition = `transform ${TRANSITION_MS}ms cubic-bezier(0.16, 1, 0.3, 1)`;
        isTransitioning = true;
        transitionTimer = window.setTimeout(finishTransition, TRANSITION_MS + 25);
      } else {
        track.style.transition = 'none';
        isTransitioning = false;
      }
      track.style.transform = `translate3d(${-currentIndex * 100}%, 0, 0)`;
      updateUI();
      preloadAdjacentMedia();
    }

    function handleNext() {
      if (count <= 1) return;
      const now = Date.now();
      if (now - lastNavTime < 100) return;
      lastNavTime = now;
      currentIndex++;
      moveSlider(true);
    }

    function handlePrev() {
      if (count <= 1) return;
      const now = Date.now();
      if (now - lastNavTime < 100) return;
      lastNavTime = now;
      currentIndex--;
      moveSlider(true);
    }

    function goToRealIndex(targetRealIdx: number) {
      if (count <= 1) return;
      const currentRealIdx = ((currentIndex % count) + count) % count;
      if (targetRealIdx === currentRealIdx) return;
      const diff = targetRealIdx - currentRealIdx;
      currentIndex += diff;
      moveSlider(true);
    }

    track.addEventListener('transitionend', (e) => {
      if (e.target === track) {
        finishTransition();
      }
    });

    // Autoplay
    function stopAutoplay() {
      if (autoplayTimer !== null) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
      const btn = modal.querySelector('[data-autoplay-btn]') as HTMLElement;
      if (btn) {
        btn.classList.remove('is-playing');
        btn.setAttribute('title', 'Запустить автопрокрутку');
      }
    }

    function startAutoplay() {
      if (count <= 1) return;
      stopAutoplay();
      const btn = modal.querySelector('[data-autoplay-btn]') as HTMLElement;
      if (btn) {
        btn.classList.add('is-playing');
        btn.setAttribute('title', 'Остановить автопрокрутку');
      }
      autoplayTimer = window.setInterval(() => {
        handleNext();
      }, 3200);
    }

    function toggleAutoplay() {
      if (autoplayTimer !== null) {
        stopAutoplay();
      } else {
        startAutoplay();
      }
    }

    // Stop autoplay when user manually plays a video
    const videoElements = modal.querySelectorAll('video');
    videoElements.forEach((vid) => {
      vid.addEventListener('play', () => {
        stopAutoplay();
      });
    });

    // Touch & Mouse Dragging
    let startX = 0;
    let currentDragX = 0;
    let isDragging = false;

    function onPointerDown(e: MouseEvent | TouchEvent) {
      if (count <= 1) return;
      const target = e.target as HTMLElement;
      if (
        target.closest('.slider-nav') || 
        target.closest('.slide-counter') || 
        target.closest('[data-autoplay-btn]') ||
        target.closest('video') ||
        target.closest('iframe') ||
        target.closest('.modal-video-wrapper')
      ) return;

      if (isTransitioning) {
        finishTransition();
      }

      isDragging = true;
      startX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      currentDragX = startX;
      track.style.transition = 'none';
    }

    function onPointerMove(e: MouseEvent | TouchEvent) {
      if (!isDragging || count <= 1) return;
      currentDragX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const deltaX = currentDragX - startX;
      const slideW = getSlideWidth() || 1;
      const deltaPercent = (deltaX / slideW) * 100;
      const currentOffset = -currentIndex * 100 + deltaPercent;
      track.style.transform = `translate3d(${currentOffset}%, 0, 0)`;
    }

    function onPointerUp() {
      if (!isDragging || count <= 1) return;
      isDragging = false;
      const deltaX = currentDragX - startX;
      if (deltaX < -30) {
        currentIndex++;
      } else if (deltaX > 30) {
        currentIndex--;
      }
      moveSlider(true);
    }

    container.addEventListener('mousedown', onPointerDown);
    window.addEventListener('mousemove', onPointerMove);
    window.addEventListener('mouseup', onPointerUp);

    container.addEventListener('touchstart', onPointerDown, { passive: true });
    container.addEventListener('touchmove', onPointerMove, { passive: true });
    container.addEventListener('touchend', onPointerUp);

    function syncMedia() {
      const remainingThumbs = modal.querySelectorAll<HTMLElement>('.thumb-btn');
      const remainingSlides = modal.querySelectorAll<HTMLElement>('.yacht-slide');

      const newCount = remainingThumbs.length > 0 ? remainingThumbs.length : Math.max(1, remainingSlides.length);
      count = newCount;
      L = count;
      track.setAttribute('data-length', String(L));
      track.setAttribute('data-count', String(count));

      // Re-index remaining thumbnails
      remainingThumbs.forEach((thumb, idx) => {
        thumb.setAttribute('data-index', String(idx));
      });

      const totalCountEl = modal.querySelector('.total-count');
      if (totalCountEl) totalCountEl.textContent = String(count);

      if (count <= 1) {
        stopAutoplay();
        modal.querySelectorAll<HTMLElement>('.slider-nav').forEach((btn) => {
          btn.style.display = 'none';
        });
        const counter = modal.querySelector<HTMLElement>('.slide-counter');
        if (counter) counter.style.display = 'none';
        const autoBtn = modal.querySelector<HTMLElement>('[data-autoplay-btn]');
        if (autoBtn) autoBtn.style.display = 'none';
        const thumbsWrap = modal.querySelector<HTMLElement>('.modal-thumbnails');
        if (thumbsWrap) thumbsWrap.style.display = 'none';

        currentIndex = 0;
        track.style.transition = 'none';
        track.style.transform = 'none';
        return;
      }

      // Ensure controls are visible when count > 1
      modal.querySelectorAll<HTMLElement>('.slider-nav').forEach((btn) => {
        btn.style.display = '';
      });
      const counter = modal.querySelector<HTMLElement>('.slide-counter');
      if (counter) counter.style.display = '';
      const autoBtn = modal.querySelector<HTMLElement>('[data-autoplay-btn]');
      if (autoBtn) autoBtn.style.display = '';
      const thumbsWrap = modal.querySelector<HTMLElement>('.modal-thumbnails');
      if (thumbsWrap) thumbsWrap.style.display = '';

      // Keep user on valid slide
      const realIdx = ((currentIndex % count) + count) % count;
      currentIndex = L + realIdx;
      track.style.transition = 'none';
      track.style.transform = `translate3d(${-currentIndex * 100}%, 0, 0)`;
      updateUI();
      preloadAdjacentMedia();
    }

    // Initial positioning
    if (count <= 1) {
      syncMedia();
    } else {
      currentIndex = L;
      moveSlider(false);
    }

    window.addEventListener('resize', () => {
      moveSlider(false);
    });

    return {
      reset: () => {
        stopAutoplay();
        pauseAllMedia(modal);
        if (count > 1) {
          currentIndex = L;
          moveSlider(false);
        } else {
          track.style.transition = 'none';
          track.style.transform = 'none';
        }
      },
      next: handleNext,
      prev: handlePrev,
      goTo: goToRealIndex,
      stopAutoplay,
      toggleAutoplay,
      pauseMedia: () => pauseAllMedia(modal),
      syncMedia
    };
  }

  function initYachtModals() {
    const slidersMap = new Map<HTMLElement, ReturnType<typeof setupModalSlider>>();
    const removedMediaByModal = new WeakMap<HTMLElement, Set<string>>();

    function removeFailedMedia(modal: HTMLElement, failedUrl: string) {
      if (!modal || !failedUrl) return;

      let removedSet = removedMediaByModal.get(modal);
      if (!removedSet) {
        removedSet = new Set<string>();
        removedMediaByModal.set(modal, removedSet);
      }

      const cleanUrl = failedUrl.trim();
      if (removedSet.has(cleanUrl)) return;
      removedSet.add(cleanUrl);

      // If this media item is a video, only the preview thumbnail failed; keep video slide intact
      const isVideoItem = modal.querySelector(`.yacht-slide[data-media-url="${cleanUrl}"][data-is-video="true"]`);
      if (isVideoItem) {
        const thumbBtn = modal.querySelector(`.thumb-btn[data-media-url="${cleanUrl}"]`);
        if (thumbBtn) {
          const img = thumbBtn.querySelector('img');
          if (img) img.remove();
          if (!thumbBtn.querySelector('.thumb-video-placeholder')) {
            const ph = document.createElement('div');
            ph.className = 'thumb-video-placeholder';
            ph.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`;
            thumbBtn.prepend(ph);
          }
        }
        return;
      }

      const isUrlMatch = (attrUrl: string | null | undefined, elSrc?: string | null) => {
        if (!attrUrl && !elSrc) return false;
        const candidates = [attrUrl, elSrc].filter(Boolean) as string[];
        return candidates.some((u) => u === cleanUrl || cleanUrl.includes(u) || u.includes(cleanUrl));
      };

      // Remove all matching slides from the track
      const slidesToRemove: HTMLElement[] = [];
      modal.querySelectorAll<HTMLElement>('.yacht-slide').forEach((slide) => {
        const slideUrl = slide.getAttribute('data-media-url');
        const img = slide.querySelector<HTMLImageElement>('img.modal-main-image');
        if (isUrlMatch(slideUrl, img?.src) || (img && isUrlMatch(img.getAttribute('data-media-url'), img.src))) {
          slidesToRemove.push(slide);
        }
      });

      // Remove matching thumbnail
      const thumbsToRemove: HTMLElement[] = [];
      modal.querySelectorAll<HTMLElement>('.thumb-btn').forEach((thumb) => {
        const thumbUrl = thumb.getAttribute('data-media-url');
        const img = thumb.querySelector<HTMLImageElement>('img');
        if (isUrlMatch(thumbUrl, img?.src) || (img && isUrlMatch(img.getAttribute('data-media-url'), img.src))) {
          thumbsToRemove.push(thumb);
        }
      });

      slidesToRemove.forEach((s) => s.remove());
      thumbsToRemove.forEach((t) => t.remove());

      // If all slides were removed
      const remainingSlides = modal.querySelectorAll<HTMLElement>('.yacht-slide');
      if (remainingSlides.length === 0) {
        const track = modal.querySelector<HTMLElement>('.yacht-slider-track');
        if (track) {
          track.innerHTML = `
            <div class="yacht-slide" style="display:flex;align-items:center;justify-content:center;min-height:300px;background:#f8fafc;color:#94a3b8;font-size:14px;">
              <span>Изображение временно недоступно</span>
            </div>
          `;
        }
      }

      // Sync slider state immediately
      const slider = slidersMap.get(modal);
      if (slider && typeof slider.syncMedia === 'function') {
        slider.syncMedia();
      }
    }

    function checkAndRemoveFailedImages(modal: HTMLElement) {
      const images = modal.querySelectorAll<HTMLImageElement>('.modal-main-image, .thumb-btn img');
      images.forEach((img) => {
        if (img.complete && img.naturalWidth === 0 && img.src) {
          const mediaUrl = img.getAttribute('data-media-url') || img.closest('[data-media-url]')?.getAttribute('data-media-url') || img.src;
          removeFailedMedia(modal, mediaUrl);
        }
      });
    }

    // Initialize all modals on page
    const modals = document.querySelectorAll('.modal-overlay');
    modals.forEach((m) => {
      const modal = m as HTMLElement;
      checkAndRemoveFailedImages(modal);
      const slider = setupModalSlider(modal);
      if (slider) slidersMap.set(modal, slider);
    });

    function closeModal(modal: HTMLElement) {
      const slider = slidersMap.get(modal);
      if (slider) {
        slider.stopAutoplay();
        slider.pauseMedia();
      }

      modal.style.display = 'none';
      modal.classList.remove('is-active');

      const openCards = modal.querySelectorAll('.accordion-card.is-open');
      openCards.forEach((openCard) => {
        openCard.classList.remove('is-open');
        const openWrapper = openCard.querySelector('.accordion-body-wrapper') as HTMLElement;
        if (openWrapper) openWrapper.style.maxHeight = '0px';
        const openArrow = openCard.querySelector('.acc-arrow');
        if (openArrow) openArrow.classList.remove('rotated');
      });

      if (!document.querySelector('.modal-overlay.is-active')) {
        document.body.style.overflow = '';
      }
    }

    // Open modal event listener
    window.addEventListener('openYachtDetails', (e: any) => {
      const yachtId = e.detail?.yachtId;
      if (!yachtId) return;

      const modal = document.getElementById(`yacht-modal-${yachtId}`) as HTMLElement;
      if (modal) {
        checkAndRemoveFailedImages(modal);
        modal.style.display = 'flex';
        modal.classList.add('is-active');
        document.body.style.overflow = 'hidden';

        let slider = slidersMap.get(modal);
        if (!slider) {
          slider = setupModalSlider(modal);
          if (slider) slidersMap.set(modal, slider);
        }
        if (slider) {
          slider.syncMedia();
          slider.reset();
        }
      }
    });

    window.addEventListener('initDynamicModal', (e: any) => {
      const modalId = e.detail?.modalId;
      if (modalId) {
        const modal = document.getElementById(modalId) as HTMLElement;
        if (modal && !slidersMap.has(modal)) {
          checkAndRemoveFailedImages(modal);
          const slider = setupModalSlider(modal);
          if (slider) slidersMap.set(modal, slider);
        }
      }
    });

    // Global click delegate
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // Autoplay button
      const autoplayBtn = target.closest('[data-autoplay-btn]');
      if (autoplayBtn) {
        const modal = autoplayBtn.closest('.modal-overlay') as HTMLElement;
        if (modal) {
          const slider = slidersMap.get(modal);
          if (slider) slider.toggleAutoplay();
        }
        return;
      }

      // 1. Close button click
      const closeBtn = target.closest('[data-close-modal]');
      if (closeBtn) {
        const modal = closeBtn.closest('.modal-overlay') as HTMLElement;
        if (modal) closeModal(modal);
        return;
      }

      // 2. Click outside container to close
      const overlay = target.closest('.modal-overlay');
      const container = target.closest('.modal-container');
      if (overlay && !container) {
        closeModal(overlay as HTMLElement);
        return;
      }

      // 3. Thumb button click to change slide
      const thumbBtn = target.closest('.thumb-btn');
      if (thumbBtn) {
        const modal = thumbBtn.closest('.modal-overlay') as HTMLElement;
        const indexStr = thumbBtn.getAttribute('data-index');
        if (modal && indexStr !== null) {
          const idx = parseInt(indexStr, 10);
          const slider = slidersMap.get(modal);
          if (slider) slider.goTo(idx);
        }
        return;
      }

      // 4. Booking button within details modal
      const bookBtn = target.closest('[data-book-yacht]');
      if (bookBtn && bookBtn.closest('.modal-overlay')) {
        const yachtName = bookBtn.getAttribute('data-book-yacht');
        const modal = bookBtn.closest('.modal-overlay') as HTMLElement;
        if (yachtName) {
          if (modal) closeModal(modal);

          window.dispatchEvent(new CustomEvent('openBooking', {
            detail: { yachtName }
          }));
        }
        return;
      }

      // 5. Navigation prev / next arrows
      const prevBtn = target.closest('.nav-prev');
      const nextBtn = target.closest('.nav-next');
      if (prevBtn || nextBtn) {
        const modal = (prevBtn || nextBtn)!.closest('.modal-overlay') as HTMLElement;
        if (!modal) return;
        const slider = slidersMap.get(modal);
        if (slider) {
          if (prevBtn) slider.prev();
          else slider.next();
        }
        return;
      }

      // 6. Accordion collapse / expand toggle
      const accHeader = target.closest('.accordion-header');
      if (accHeader) {
        const card = accHeader.closest('.accordion-card');
        const wrapper = card?.querySelector('.accordion-body-wrapper') as HTMLElement;
        const arrow = accHeader.querySelector('.acc-arrow');
        if (card && wrapper) {
          const isOpen = card.classList.contains('is-open');
          if (isOpen) {
            card.classList.remove('is-open');
            wrapper.style.maxHeight = '0px';
            if (arrow) arrow.classList.remove('rotated');
          } else {
            const modal = card.closest('.modal-overlay');
            if (modal) {
              const openCards = modal.querySelectorAll('.accordion-card.is-open');
              openCards.forEach((openCard) => {
                if (openCard !== card) {
                  openCard.classList.remove('is-open');
                  const openWrapper = openCard.querySelector('.accordion-body-wrapper') as HTMLElement;
                  if (openWrapper) openWrapper.style.maxHeight = '0px';
                  const openArrow = openCard.querySelector('.acc-arrow');
                  if (openArrow) openArrow.classList.remove('rotated');
                }
              });
            }

            card.classList.add('is-open');
            const inner = wrapper.querySelector('.accordion-body-inner') as HTMLElement;
            wrapper.style.maxHeight = inner ? `${inner.scrollHeight}px` : '1200px';
            if (arrow) arrow.classList.add('rotated');
          }
        }
        return;
      }
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      const activeModal = document.querySelector('.modal-overlay.is-active') as HTMLElement;
      if (!activeModal) return;

      const activeEl = document.activeElement as HTMLElement;
      const isTyping = activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA' || activeEl.isContentEditable);

      if (e.key === 'Escape') {
        closeModal(activeModal);
      } else if (e.key === 'ArrowLeft' && !isTyping) {
        const slider = slidersMap.get(activeModal);
        if (slider) slider.prev();
      } else if (e.key === 'ArrowRight' && !isTyping) {
        const slider = slidersMap.get(activeModal);
        if (slider) slider.next();
      }
    });

    // Image error handling: try Google Drive format conversion if applicable; otherwise completely remove failed media item
    document.addEventListener('error', (e) => {
      const target = e.target as HTMLImageElement;
      if (!target || target.tagName !== 'IMG') return;

      const currentSrc = target.src || '';

      if (currentSrc.includes('lh3.googleusercontent.com/d/') && !target.dataset.triedThumbnail) {
        target.dataset.triedThumbnail = 'true';
        const fileId = currentSrc.split('lh3.googleusercontent.com/d/')[1]?.split('=')[0];
        if (fileId) {
          target.src = `https://drive.google.com/thumbnail?id=${fileId}&sz=w1200`;
          return;
        }
      }
      if (currentSrc.includes('drive.google.com/thumbnail') && !target.dataset.triedUc) {
        target.dataset.triedUc = 'true';
        const match = currentSrc.match(/id=([a-zA-Z0-9_-]+)/);
        if (match && match[1]) {
          target.src = `https://drive.google.com/uc?export=view&id=${match[1]}`;
          return;
        }
      }

      // If still failing, completely remove this broken media item from the modal gallery!
      const modal = target.closest('.modal-overlay') as HTMLElement;
      if (modal) {
        const mediaUrl = target.getAttribute('data-media-url') || target.closest('[data-media-url]')?.getAttribute('data-media-url') || currentSrc;
        removeFailedMedia(modal, mediaUrl);
      }
    }, true);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initYachtModals);
  } else {
    initYachtModals();
  }
</script>
